{
  "name": "cee-site",
  "version": "0.0.0",
  "description": "Sítio do Centro de Estudos Econômicos (CEE) — iniciativa estudantil de análise econômica empírica.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "data:fetch": "NODE_USE_ENV_PROXY=1 node scripts/data/fetch.ts",
    "data:process": "node scripts/data/process.ts",
    "data:catalogo": "node scripts/data/catalogo.ts",
    "data": "npm run data:fetch && npm run data:process && npm run data:derive && npm run data:catalogo && npm test",
    "test": "vitest run",
    "qa:screens": "node scripts/qa/screens.mjs",
    "qa:links": "node scripts/qa/links.mjs dist",
    "qa:busca": "node scripts/qa/busca.mjs",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "data:derive": "node scripts/data/derive.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@observablehq/plot": "0.6.17",
    "@types/d3": "7.4.3",
    "astro": "7.4.1",
    "d3": "7.9.0",
    "linkedom": "0.18.13",
    "pagefind": "1.5.2",
    "read-excel-file": "9.3.12",
    "typescript": "6.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@resvg/resvg-js": "2.6.2",
    "astro-eslint-parser": "1.4.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.13.0",
    "lighthouse": "12.8.2",
    "playwright": "1.64.1",
    "postcss-html": "2.0.0",
    "satori": "0.63.0",
    "stylelint": "16.26.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "38.0.0",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7",
    "wait-on": "9.5.1"
  }
}
