{
  "name": "cee-site",
  "version": "0.0.0",
  "description": "Sítio do Centro de Estudos Econômicos (CEE) — iniciativa estudantil de análise econômica empírica.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "data:fetch": "NODE_USE_ENV_PROXY=1 node scripts/data/fetch.ts",
    "data:process": "node scripts/data/process.ts",
    "data:catalogo": "node scripts/data/catalogo.ts",
    "data": "npm run data:fetch && npm run data:process && npm run data:derive && npm run data:catalogo && npm test",
    "test": "vitest run",
    "qa:screens": "node scripts/qa/screens.mjs",
    "qa:links": "node scripts/qa/links.mjs dist",
    "qa:busca": "node scripts/qa/busca.mjs",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "data:derive": "node scripts/data/derive.ts",
    "qa:seguranca": "node scripts/qa/seguranca.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.7",
    "fflate": "0.8.3",
    "lucide-static": "1.70.0",
    "pagefind": "1.6.0",
    "read-excel-file": "9.3.14",
    "simple-icons": "16.36.0",
    "typescript": "6.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource/source-serif-4": "5.3.1",
    "@resvg/resvg-js": "2.6.2",
    "astro-eslint-parser": "1.4.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "opentype.js": "2.0.0",
    "playwright": "1.65.0",
    "postcss-html": "2.0.0",
    "satori": "0.63.2",
    "stylelint": "16.26.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "38.0.0",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici@7": "7.30.1"
  }
}
