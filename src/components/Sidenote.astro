---
/**
 * Nota lateral: na margem em telas largas, em linha (entre colchetes numerados) em telas estreitas.
 * Uso em MDX: texto<Sidenote n={1}>Comentário.</Sidenote> continua.
 */
interface Props { n: number | string }
const { n } = Astro.props;
---
<span class="sidenote-ref" aria-hidden="true">{n}</span><small class="sidenote"><span class="sidenote__n">{n}</span> <slot /></small>
<style>
  .sidenote-ref {
    font-family: var(--sans);
    font-size: 0.7em;
    font-weight: 700;
    vertical-align: super;
    line-height: 0;
    color: var(--petrol);
  }
  .sidenote {
    display: block;
    margin: var(--s-2) 0;
    padding-left: var(--s-3);
    border-left: 2px solid var(--line);
    font-family: var(--sans);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--muted);
  }
  .sidenote__n { font-weight: 700; color: var(--petrol); }
  @media (min-width: 76rem) {
    .sidenote {
      float: right;
      clear: right;
      width: 14rem;
      margin: 0 -16rem var(--s-3) 0;
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
