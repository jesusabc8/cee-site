---
/**
 * Caixa de destaque com régua lateral (sem sombra).
 * - limits: "O que a evidência não permite concluir" (obrigatória em Nota Técnica)
 * - note: observação metodológica
 * - placeholder: conteúdo provisório, sempre visível como tal
 */
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  variant?: 'limits' | 'note' | 'placeholder';
  title?: string;
  lang?: Lang;
}
const { variant = 'note', title, lang = 'pt-BR' } = Astro.props;
const t = useTranslations(lang);
const defaults = { limits: t('box.limits'), note: t('box.note'), placeholder: `[PLACEHOLDER] ${t('box.placeholder')}` };
const heading = title ?? defaults[variant];
const id = `box-${Math.random().toString(36).slice(2, 8)}`;
---
<section class={`box box--${variant}`} aria-labelledby={id}>
  <h2 id={id} class="box__title">{heading}</h2>
  <div class="box__body"><slot /></div>
</section>
<style>
  .box {
    position: relative;
    margin-top: 1.6em;
    border: 1px solid var(--line);
    border-left: 4px solid var(--line-strong);
    background: var(--paper);
    padding: 20px 24px 20px 26px;
    max-width: var(--measure);
    font-family: var(--sans);
    font-size: var(--step-0);
  }
  .box--note { border-left-color: var(--navy); background: linear-gradient(135deg, var(--paper), var(--mist)); }
  .box--limits { border-left-color: var(--petrol); }
  .box--placeholder {
    border: 1px dashed var(--petrol);
    border-left-width: 3px;
    background: var(--mist);
  }
  .box__title {
    /* Anula o estilo de h2 do texto corrido (.prose h2 e .prose--inst > h2). */
    margin: 0 0 var(--s-2);
    padding: 0;
    border: 0;
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .box__title::before, .box__title::after { content: none; }
  .box__body :global(p) { max-width: 70ch; line-height: 1.6; }
  .box__body > :global(* + *) { margin-top: var(--s-2); }
  .box__body :global(ul) { padding-left: 1.2em; margin: 0; }
</style>
