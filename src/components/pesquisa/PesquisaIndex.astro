---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../layout/PageHero.astro';
import Areas from '../home/Areas.astro';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const areas = (await getCollection('areas')).sort((a, b) => a.data.ordem - b.data.ordem);
// Linhas do ano 1 derivadas de linhas.yaml (nunca escritas à mão).
const ano1 = (await getCollection('linhas', (l) => l.data.ano === 1)).map((l) => l.data.codigo).sort();
const EXT = { pt: ['zero', 'uma', 'duas', 'três', 'quatro', 'cinco', 'seis', 'sete'], en: ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven'] };
const lista = (xs: string[], e: string) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} ${e} ${xs.at(-1)}` : xs.join(''));
const lente = areas.find((a) => a.data.tipo === 'lente');

const T = {
  pt: {
    title: 'Pesquisa', eyebrow: 'Agenda',
    lede: 'Um observatório de dados no centro, três áreas permanentes ao redor e uma lente transversal. As áreas foram derivadas das perguntas que a literatura e os documentos de conjuntura colocam, e não de uma taxonomia abstrata.',
    niveis: 'Área, linha e tema',
    niveisTxt: 'A área é um campo permanente de trabalho, com uma pergunta-guia, e só muda por reforma da Carta de Princípios. A linha é uma agenda de dois a três anos dentro de uma área. O tema é um projeto de um semestre que gera um ou mais produtos.',
    obs: 'Observatório CEE — Economia Brasileira em Dados', obsTxt: 'Não é uma das áreas: é a infraestrutura que as três compartilham — séries econômicas brasileiras em formato limpo e versionado, com dicionário de variáveis, script de extração e data de cada atualização.', obsLink: 'Ver o Observatório',
    lenteTit: 'Lente transversal',
    regras: 'Regras de gestão das linhas',
    regrasList: [
      '<strong>Abertura</strong>: pergunta-guia escrita; dados abertos verificados; ao menos três integrantes e um docente de referência; um produto comprometido em até seis meses.',
      '<strong>Estado latente</strong>: dois semestres consecutivos sem produto publicado.',
      `<strong>Capacidade primeiro</strong>: no primeiro ano, apenas ${EXT.pt[ano1.length] ?? ano1.length} linhas (${lista(ano1, 'e')}).`,
      '<strong>Recorte mineiro</strong>: Minas Gerais entra quando agrega algo que as instituições estaduais já existentes não cobrem; não é obrigatório em cada produto.',
    ],
    estadoNota: 'Nenhuma linha está ativa ainda: as linhas previstas para o ano 1 serão abertas quando cumprirem os critérios acima.',
  },
  en: {
    title: 'Research', eyebrow: 'Agenda',
    lede: 'A data observatory at the centre, three permanent areas around it and one cross-cutting lens. The areas were derived from the questions raised by the literature and by current macroeconomic reports, not from an abstract taxonomy.',
    niveis: 'Area, line and topic',
    niveisTxt: 'An area is a permanent field of work with a guiding question, changed only by amending the Charter. A line is a two-to-three-year agenda within an area. A topic is a one-semester project producing one or more outputs.',
    obs: 'CEE Observatory — Brazilian Economy in Data', obsTxt: 'Not an area but the infrastructure all three share — clean, versioned Brazilian economic series with a data dictionary, extraction script and the date of every update.', obsLink: 'Go to the Observatory',
    lenteTit: 'Cross-cutting lens',
    regras: 'Rules for research lines',
    regrasList: [
      '<strong>Opening</strong>: a written guiding question; verified open data; at least three members and a faculty adviser; one product committed within six months.',
      '<strong>Dormancy</strong>: two consecutive semesters without a published product.',
      `<strong>Capacity first</strong>: only ${EXT.en[ano1.length] ?? ano1.length} lines in year one (${lista(ano1, 'and')}).`,
      '<strong>Minas Gerais focus</strong>: used only when it adds something existing state institutions do not cover.',
    ],
    estadoNota: 'No line is active yet: year-1 lines will open once they meet the criteria above.',
  },
}[k];
---
<Base title={T.title} description={T.lede} lang={lang}>
  <PageHero lang={lang} eyebrow={T.eyebrow} icon="compass" title={T.title} lede={T.lede} />
  <Areas lang={lang} />
  <div class="wrap">
    <section class="section split">
      <h2 class="section__title">{T.niveis}</h2>
      <div class="prose">
        <p>{T.niveisTxt}</p>
        <p class="meta">{T.estadoNota}</p>
      </div>
    </section>

    <section class="section split">
      <h2 class="section__title">L0 · {T.obs}</h2>
      <div class="prose">
        <p>{T.obsTxt}</p>
        <p><a href={href('/observatorio/', lang)}>{T.obsLink}</a></p>
      </div>
    </section>

    {lente && (
      <section class="section split">
        <h2 class="section__title">{T.lenteTit}</h2>
        <div class="prose">
          <h3><a href={href(`/pesquisa/${lente.id}/`, lang)}>{lente.data.nome[k]}</a></h3>
          <p>{lente.data.descricao[k]}</p>
        </div>
      </section>
    )}

    <section class="section split">
      <h2 class="section__title">{T.regras}</h2>
      <ul class="prose">{T.regrasList.map((r) => <li set:html={r} />)}</ul>
    </section>
  </div>
</Base>
