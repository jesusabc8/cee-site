---
/**
 * Página de programa de pesquisa (/pesquisa/<id>/). Conteúdo de src/data/programas.yaml (Manual, Parte I).
 * Programa em formação: objeto e perguntas, com o rótulo "Em formação" e os painéis previstos para quando o programa
 * for ativado; sem painel, Coordenador, equipe nem produtos inexistentes (Manual, Parte I, §1.2).
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../layout/PageHero.astro';
import StatusTag from '../StatusTag.astro';
import PubRow from '../pub/PubRow.astro';
import { getPublicacoes } from '../../lib/publicacoes';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { area: CollectionEntry<'programas'>; lang: Lang }
const { area: prog, lang } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const d = prog.data;
const emFormacao = d.situacao === 'em-formacao';
const paineis = emFormacao ? [] : (await getCollection('paineis', (p) => p.data.area === prog.id)).sort((a, b) => a.data.linha.localeCompare(b.data.linha));
const relacionadas = emFormacao ? [] : (await getPublicacoes()).filter((p) => p.data.area === prog.id);
const T = {
  pt: { programa: 'Programa', transversal: 'Programa transversal', objeto: 'Objeto', abrange: 'Abrange', nao: 'Não abrange', perguntas: 'Perguntas de pesquisa',
    sub: 'Subprograma', paineis: 'Painéis do Observatório', previstos: 'Painéis previstos quando o programa for ativado', dados: 'Dados principais', refs: 'Referências de partida',
    pubs: 'Publicações relacionadas', semPubs: 'Nenhuma publicação neste programa até o momento.', voltar: 'Todos os programas', abrir: 'Abrir painel',
    formacao: 'Programa em formação: suas perguntas integram a agenda e podem originar Data Insights, Notas de Conjuntura e Blogs, sob supervisão do Economista-Chefe, mas ele não abre painel nem tem Coordenador até ser ativado pela Diretoria Colegiada.' },
  en: { programa: 'Programme', transversal: 'Cross-cutting programme', objeto: 'Scope', abrange: 'Covers', nao: 'Does not cover', perguntas: 'Research questions',
    sub: 'Sub-programme', paineis: 'Observatory panels', previstos: 'Panels planned for when the programme is activated', dados: 'Main data', refs: 'Starting references',
    pubs: 'Related publications', semPubs: 'No publications in this programme yet.', voltar: 'All programmes', abrir: 'Open dashboard',
    formacao: 'Programme in formation: its questions are part of the agenda and may give rise to Data Insights, Business-Cycle Notes and Blog posts under the Chief Economist\'s supervision, but it opens no panel and has no Coordinator until the Board activates it.' },
}[k];
const eyebrow = d.tipo === 'transversal' ? T.transversal : `${T.programa} ${d.codigo}`;
const perguntas = d.perguntas ?? [];
---
<Base title={`${d.codigo !== 'T' ? `${d.codigo} — ` : ''}${d.nome[k]}`} description={d.objeto[k]} lang={lang}>
  <PageHero lang={lang} eyebrow={eyebrow} title={d.nome[k]} lede={d.objeto[k]}>
    {d.situacao && <p><StatusTag estado={d.situacao} lang={lang} /></p>}
  </PageHero>
  <div class="wrap">

    {emFormacao && <p class="formacao">{T.formacao}</p>}

    {d.nota && (
      <section class="section split">
        <h2 class="section__title">{T.objeto}</h2>
        <p class="prose">{d.nota[k]}</p>
      </section>
    )}

    {(d.abrange || d.nao_abrange) && (
      <section class="section split">
        <h2 class="section__title">{T.abrange}</h2>
        <div class="prose">
          {d.abrange && <p>{d.abrange[k]}</p>}
          {d.nao_abrange && <p><strong>{T.nao}:</strong> {d.nao_abrange[k]}</p>}
        </div>
      </section>
    )}

    <section class="section split" id="perguntas">
      <h2 class="section__title">{T.perguntas}</h2>
      <div class="perguntas">
        {d.subprogramas?.map((s) => (
          <div class="sub">
            <h3><span class="code">{s.codigo}</span> {s.nome[k]}</h3>
            <ol>{s.perguntas.map((q) => <li><span class="code">{q.codigo}</span> {q[k]}</li>)}</ol>
          </div>
        ))}
        {perguntas.length > 0 && <ol>{perguntas.map((q) => <li><span class="code">{q.codigo}</span> {q[k]}</li>)}</ol>}
      </div>
    </section>

    {paineis.length > 0 && (
      <section class="section split">
        <h2 class="section__title">{T.paineis}</h2>
        <ul class="paineis">
          {paineis.map((p) => (
            <li>
              <span class="code">{p.data.linha}</span>
              {p.data.estado === 'publicado' || p.data.estado === 'em-institucionalizacao'
                ? <a href={href(`/observatorio/${p.id}/`, lang)}>{p.data.titulo[k]}</a>
                : <span>{p.data.titulo[k]}</span>}
              {p.data.estado === 'publicado'
                ? <span class="ed mono">{k === 'en' ? 'Edition' : 'Edição'} {p.data.versao}</span>
                : <StatusTag estado={p.data.estado === 'previsto' ? 'previsto' : 'construcao'} ano={p.data.ano} lang={lang} />}
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.paineis_previstos && (
      <section class="section split">
        <h2 class="section__title">{T.previstos}</h2>
        <ul class="paineis">{d.paineis_previstos.map((p) => <li><span class="code">{p.codigo}</span><span>{p[k]}</span></li>)}</ul>
      </section>
    )}

    {d.dados && (
      <section class="section split">
        <h2 class="section__title">{T.dados}</h2>
        <p class="prose">{d.dados}</p>
      </section>
    )}

    {d.referencias && (
      <section class="section split">
        <h2 class="section__title">{T.refs}</h2>
        <p class="prose">{d.referencias}</p>
      </section>
    )}

    {!emFormacao && (
      <section class="section split">
        <h2 class="section__title">{T.pubs}</h2>
        <div>{relacionadas.length === 0 ? <p class="meta">{T.semPubs}</p> : relacionadas.map((p) => <PubRow pub={p} lang={lang} />)}</div>
      </section>
    )}

    <p class="meta"><a href={href('/pesquisa/', lang)}>← {T.voltar}</a></p>
  </div>
</Base>
<style>
  .formacao { margin: clamp(40px, 5vw, 56px) 0 0; padding: 16px 20px; border-left: 3px solid var(--slate); background: var(--paper); color: var(--ink); max-width: 72ch; }
  .code { font: 600 0.8125rem / 1.6 var(--mono); color: var(--petrol); margin-right: 6px; }
  .perguntas { display: grid; gap: var(--s-5); }
  .perguntas h3 { font-size: 1.125rem; margin-bottom: var(--s-2); }
  .perguntas ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .perguntas li { font: 400 1.0625rem / 1.55 var(--serif); color: var(--ink); max-width: 70ch; }
  .paineis { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  .paineis li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; }
  .ed { color: var(--navy); }
</style>
