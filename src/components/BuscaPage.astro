---
/** Busca estática com Pagefind (índice gerado no build; nenhum serviço externo). */
import Base from '../layouts/Base.astro';
import PageHero from './layout/PageHero.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = lang === 'en'
  ? { t: 'Search', lede: 'Search publications, dashboards and institutional pages. The index is built with the site and runs in your browser.', label: 'Search the site', semjs: 'Search requires JavaScript. You can browse the publications list instead.' }
  : { t: 'Buscar', lede: 'Busque em publicações, painéis e páginas institucionais. O índice é gerado com o sítio e a busca roda no seu navegador.', label: 'Buscar no sítio', semjs: 'A busca exige JavaScript. Você pode navegar pela lista de publicações.' };
---
<Base title={L.t} description={L.lede} lang={lang} noindex>
  <link slot="head" rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
  <PageHero lang={lang} title={L.t} lede={L.lede} />
  <div class="wrap">
    <label id="busca-label" for="busca-campo" class="eyebrow busca-label">{L.label}</label>
    <div id="busca" class="busca" data-base={base} data-lang={lang} data-label={L.label}></div>
    <noscript><p class="meta">{L.semjs}</p></noscript>
  </div>
</Base>
<script is:inline define:vars={{ base }}>
  const s = document.createElement('script');
  s.src = `${base}/pagefind/pagefind-ui.js`;
  s.onload = () => {
    const el = document.getElementById('busca');
    new PagefindUI({ element: '#busca', showSubResults: true, showImages: false, resetStyles: false,
      translations: { placeholder: el.dataset.label } });
    const input = el.querySelector('input');
    if (input) { input.id = 'busca-campo'; input.setAttribute('aria-labelledby', 'busca-label'); }
  };
  document.head.appendChild(s);
</script>
<style>
  .busca {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--petrol);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--white);
    --pagefind-ui-border: var(--line-strong);
    --pagefind-ui-tag: var(--paper);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--sans);
    max-width: 48rem;
    padding-top: var(--s-2);
  }
  .busca-label { display: block; border-top: var(--hairline); padding-top: var(--s-5); }
</style>
