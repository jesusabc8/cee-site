---
import { useTranslations, type Lang } from '../i18n/ui';
export type Estado = 'prevista' | 'ativa' | 'latente' | 'planejada' | 'construcao';
interface Props { estado: Estado; lang?: Lang }
const { estado, lang = 'pt-BR' } = Astro.props;
const t = useTranslations(lang);
---
<span class={`status status--${estado}`}>{t(`status.${estado}`)}</span>
<style>
  .status {
    display: inline-block;
    font: 500 10px / 1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    white-space: nowrap;
    vertical-align: 0.15em;
  }
  .status--ativa { border-color: var(--petrol); color: var(--petrol); }
  .status--prevista { border-color: var(--navy); color: var(--navy); }
  :where(.band-navy, .band-petrol) .status { border-color: rgb(255 255 255 / 35%); color: var(--muted-on-dark); }
</style>
