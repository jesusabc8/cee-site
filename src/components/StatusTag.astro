---
import { useTranslations, type Lang } from '../i18n/ui';
export type Estado = 'prevista' | 'ativa' | 'latente' | 'planejada' | 'construcao' | 'previsto';
/** `ano` vem do dado (linhas.yaml ou paineis.yaml) e substitui {ano} no rótulo ("Previsto · ano N"). */
interface Props { estado: Estado; ano?: number; lang?: Lang }
const { estado, ano, lang = 'pt-BR' } = Astro.props;
const t = useTranslations(lang);
const rotulo = t(`status.${estado}`);
if (rotulo.includes('{ano}') && ano === undefined) throw new Error(`StatusTag: estado "${estado}" exige \`ano\`.`);
---
<span class={`status status--${estado}`}>{rotulo.replace('{ano}', String(ano))}</span>
<style>
  .status {
    display: inline-block;
    font: 500 10px / 1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    white-space: nowrap;
    vertical-align: 0.15em;
  }
  .status--ativa { border-color: var(--petrol); color: var(--petrol); }
  .status--prevista { border-color: var(--navy); color: var(--navy); }
  :where(.band-navy, .band-petrol) .status { border-color: rgb(255 255 255 / 35%); color: var(--muted-on-dark); }
</style>
