---
/** Faixa de números-chave. Só fatos dos atos normativos ou derivados dos dados (nada estimado). */
interface Props { itens: { valor: string; rotulo: string; nota?: string }[] }
const { itens } = Astro.props;
---
<dl class="numeros">
  {itens.map((i) => (
    <div class="numeros__item">
      <dt class="numeros__rot">{i.rotulo}</dt>
      <dd class="numeros__val">{i.valor}</dd>
      {i.nota && <dd class="numeros__nota">{i.nota}</dd>}
    </div>
  ))}
</dl>
<style>
  .numeros { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); margin: 1.6em 0 0; border-top: 2px solid var(--navy); border-bottom: 1px solid var(--line); }
  .numeros__item { display: flex; flex-direction: column; padding: 20px 20px 18px 0; }
  .numeros__item + .numeros__item { padding-left: 20px; border-left: 1px solid var(--line); }
  .numeros__val { order: -1; margin: 0; font: 600 2.5rem / 1 var(--sans); letter-spacing: -0.03em; color: var(--navy); font-variant-numeric: lining-nums; }
  .numeros__rot { margin-top: 10px; font: 600 12px / 1.35 var(--sans); letter-spacing: 0.04em; color: var(--ink); }
  .numeros__nota { margin: 4px 0 0; font: 500 11px / 1.4 var(--mono); color: var(--muted); }
  @media (max-width: 40rem) {
    .numeros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numeros > .numeros__item:nth-child(odd) { padding-left: 0; border-left: 0; }
    .numeros__item:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .numeros__val { font-size: 1.75rem; }
  }
</style>
