---
/** Lista de verificação em duas colunas, com marca de conferência. */
import Icon from '../ui/Icon.astro';
interface Props { itens: string[]; rotulo?: string }
const { itens, rotulo } = Astro.props;
---
<ul class="check" aria-label={rotulo}>
  {itens.map((i) => <li><span class="check__ic"><Icon name="check" size={14} strokeWidth={2.4} /></span><span>{i}</span></li>)}
</ul>
<style>
  .check { list-style: none; margin: 1.4em 0 0; padding: 0; display: grid; gap: 0 32px; border-top: 2px solid var(--navy); }
  @media (min-width: 48rem) { .check { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .check li { display: flex; gap: 12px; align-items: flex-start; margin: 0; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.96875rem; line-height: 1.5; }
  .check__ic { display: grid; place-items: center; flex: none; width: 22px; height: 22px; margin-top: 1px; color: var(--white); background: var(--petrol); border-radius: 50%; }
</style>
