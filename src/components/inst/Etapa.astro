---
/** Item de <Etapas>: número automático, título e texto. */
interface Props { titulo: string }
const { titulo } = Astro.props;
---
<li class="etapa">
  <span class="etapa__n" aria-hidden="true"></span>
  <div class="etapa__corpo">
    <p class="etapa__tit">{titulo}</p>
    <div class="etapa__txt"><slot /></div>
  </div>
</li>
<style>
  .etapa { counter-increment: etapa; position: relative; margin: 0; }
  .etapa__n::before { content: counter(etapa, decimal-leading-zero); }
  .etapa__tit { margin: 0; max-width: none; font: 600 1.0625rem / 1.3 var(--sans); color: var(--navy); }
  .etapa__txt :global(p) { margin: 6px 0 0; max-width: 62ch; font-size: 0.96875rem; line-height: 1.6; color: #34465c; }
  /* vertical: linha do tempo */
  :global(.etapas--v) > .etapa { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 18px; padding-bottom: 22px; }
  :global(.etapas--v) > .etapa::before { content: ''; position: absolute; left: 23px; top: 44px; bottom: 0; width: 2px; background: var(--line); }
  :global(.etapas--v) > .etapa:last-child::before { display: none; }
  :global(.etapas--v) .etapa__n { display: grid; place-items: center; width: 46px; height: 46px; border: 2px solid var(--navy); border-radius: 50%; background: var(--white); font: 600 0.9375rem / 1 var(--mono); color: var(--navy); position: relative; z-index: 1; }
  :global(.etapas--v) .etapa__corpo { padding-top: 11px; }
  /* horizontal: faixa em colunas */
  :global(.etapas--h) > .etapa { padding: 20px 20px 22px 0; }
  :global(.etapas--h) .etapa__n { display: block; margin-bottom: 14px; font: 600 2rem / 1 var(--sans); letter-spacing: -0.03em; color: var(--petrol); }
  @media (min-width: 48rem) {
    :global(.etapas--h) > .etapa + .etapa { padding-left: 20px; border-left: 1px solid var(--line); }
    :global(.etapas--h) > .etapa:not(:last-child)::after { content: '→'; position: absolute; right: -9px; top: 22px; font: 600 1rem / 1 var(--sans); color: var(--slate); background: var(--white); padding: 0 2px; z-index: 1; }
  }
  @media (max-width: 47.99rem) { :global(.etapas--h) > .etapa + .etapa { border-top: 1px solid var(--line); } }
</style>
