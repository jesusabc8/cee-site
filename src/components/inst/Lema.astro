---
/** Lema institucional: painel marinho com citação em serifa itálica e fonte normativa. */
import Icon from '../ui/Icon.astro';
interface Props { fonte?: string }
const { fonte } = Astro.props;
---
<figure class="lema">
  <span class="lema__icone"><Icon name="quote" size={28} /></span>
  <blockquote class="lema__txt"><slot /></blockquote>
  {fonte && <figcaption class="lema__fonte">{fonte}</figcaption>}
</figure>
<style>
  .lema { position: relative; margin: 1.6em 0 0; padding: 40px 44px 34px; overflow: hidden; color: var(--white);
    background: radial-gradient(560px 260px at 100% 0%, rgb(60 141 203 / 35%), transparent 65%), linear-gradient(135deg, var(--navy-deep), var(--navy)); }
  .lema::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgb(255 255 255 / 4%) 0 1px, transparent 1px 120px); pointer-events: none; }
  .lema__icone { color: var(--sky); display: block; margin-bottom: 14px; }
  .lema__txt { position: relative; z-index: 1; margin: 0; padding: 0; border: 0; font: italic 400 clamp(1.375rem, 1.1rem + 1vw, 1.875rem) / 1.4 var(--serif); color: var(--white); }
  .lema__txt :global(p) { margin: 0; max-width: none; color: inherit; font: inherit; }
  .lema__fonte { position: relative; z-index: 1; margin-top: 18px; font: 500 12px / 1.4 var(--mono); color: var(--muted-on-dark); letter-spacing: 0.02em; }
  @media (max-width: 40rem) { .lema { padding: 30px 22px 26px; } }
</style>
