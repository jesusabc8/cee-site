---
/** Linha de lista editorial (não cartão): tipo · data · área, título, resumo, autoria por função. */
import { getEntry } from 'astro:content';
import type { Pub } from '../../lib/publicacoes';
import { fmtDate, isoDate } from '../../lib/publicacoes';
import { TIPOS } from '../../schemas/publicacao';
import { CREDIT } from '../../schemas/credit';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { pub: Pub; lang: Lang; headingLevel?: 'h2' | 'h3' }
const { pub, lang, headingLevel = 'h3' } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const p = pub.data;
const area = await getEntry('areas', p.area);
const H = headingLevel;
const titulo = k === 'en' && p.titulo_en ? p.titulo_en : p.titulo;
const resumo = k === 'en' && p.resumo_en ? p.resumo_en : p.resumo;
const autores = p.autoria.map((a) => `${a.nome} (${a.funcao_credit.map((f) => CREDIT[f][k]).slice(0, 2).join(', ')})`).join('; ');
---
<article class="pub-row" data-tipo={p.tipo} data-area={p.area} data-ano={p.data.getUTCFullYear()}
  data-autores={p.autoria.map((a) => a.nome).join('|')}>
  <p class="pub-row__meta meta">
    <span class="pub-row__tipo">{TIPOS[p.tipo][k]}{p.numero && ` ${p.numero}`}</span>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(p.data)}>{fmtDate(p.data, lang, 'short')}</time>
    {area && <><span aria-hidden="true">·</span> <span>{area.data.codigo} {area.data.nome[k]}</span></>}
  </p>
  <H class="pub-row__title"><a href={href(`/publicacoes/${pub.id}/`, lang)}>{titulo}</a></H>
  <p class="pub-row__resumo">{resumo}</p>
  <p class="meta pub-row__autores">{autores}</p>
</article>
<style>
  .pub-row { padding-block: var(--s-4) var(--s-5); border-top: var(--hairline); }
  .pub-row__meta { display: flex; flex-wrap: wrap; gap: 0 var(--s-2); }
  .pub-row__tipo { font-weight: 600; color: var(--petrol); }
  .pub-row__title { font-size: var(--step-2); margin-top: var(--s-1); max-width: 48rem; }
  .pub-row__title a { color: var(--ink); text-decoration: none; }
  .pub-row__title a:hover { color: var(--petrol); text-decoration: underline; }
  .pub-row__resumo {
    font-family: var(--serif);
    margin-top: var(--s-2);
    max-width: var(--measure);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pub-row__autores { margin-top: var(--s-2); }
</style>
