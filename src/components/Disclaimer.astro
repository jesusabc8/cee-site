---
/**
 * Aviso de responsabilidade (Manual de Programas e Produtos, Parte II, "Aviso de responsabilidade e licença").
 * - variant="short": rodapé de todas as páginas.
 * - variant="full": final de cada publicação; a Avaliação de Conjuntura acrescenta que expressa o juízo
 *   colegiado da Diretoria.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  variant?: 'short' | 'full';
  /** Tipo da publicação (variant="full"). */
  tipo?: string;
}
const { lang, variant = 'short', tipo } = Astro.props;

const textos = {
  'pt-BR': {
    short: 'O CEE é uma liga acadêmica estudantil. As opiniões expressas em suas publicações são de responsabilidade dos autores e não representam a posição da Pontifícia Universidade Católica de Minas Gerais.',
    aviso: 'As opiniões expressas são de responsabilidade dos autores e não representam a posição da Pontifícia Universidade Católica de Minas Gerais.',
    ac: 'Esta Avaliação de Conjuntura expressa o juízo colegiado da Diretoria do CEE.',
    licenca: 'Publicado sob licença Creative Commons Atribuição 4.0 (CC BY 4.0), salvo restrição de terceiros.',
    errata: 'Erros identificados após a publicação são corrigidos por errata pública e datada.',
    titulo: 'Aviso de responsabilidade',
  },
  en: {
    short: 'CEE is a student academic society. The views expressed in its publications are those of the authors and do not represent the position of the Pontifical Catholic University of Minas Gerais.',
    aviso: 'The views expressed are those of the authors and do not represent the position of the Pontifical Catholic University of Minas Gerais.',
    ac: 'This Economic Assessment expresses the collegiate judgement of the CEE Board.',
    licenca: 'Published under a Creative Commons Attribution 4.0 licence (CC BY 4.0), unless restricted by third parties.',
    errata: 'Errors identified after publication are corrected through a public, dated erratum.',
    titulo: 'Disclaimer',
  },
}[lang];
---
{variant === 'short' ? (
  <p class="disclaimer disclaimer--short">{textos.short}</p>
) : (
  <aside class="disclaimer disclaimer--full" aria-labelledby="descargo-titulo">
    <h2 id="descargo-titulo" class="eyebrow">{textos.titulo}</h2>
    <p>{textos.aviso}{tipo === 'avaliacao-de-conjuntura' && ` ${textos.ac}`} {textos.licenca} {textos.errata}</p>
  </aside>
)}
<style>
  .disclaimer { font-family: var(--sans); color: var(--muted); }
  .disclaimer--short { font-size: var(--step--1); max-width: var(--measure); }
  .disclaimer--full {
    border-top: var(--hairline);
    padding-top: var(--s-4);
    font-size: var(--step--1);
    max-width: var(--measure);
  }
  .disclaimer--full h2 { margin-bottom: var(--s-2); font-size: var(--step--2); }
</style>
