---
/** Ficha de indicador do OPM, gerada de src/data/opm/indicadores.yaml; fórmula em MathML (build). */
import Formula from './Formula.astro';
import { href } from '../../i18n/routing';
import type { Indicador } from '../../lib/opm-dados';
import type { Lang } from '../../i18n/ui';
interface Props { i: Indicador; lang: Lang; nivel?: 'h3' | 'h4' }
const { i, lang, nivel = 'h3' } = Astro.props;
const H = nivel;
const k = lang === 'en' ? 'en' : 'pt';
const en = k === 'en';
const exp = i.camada === 3;
const selo = `${en ? 'Layer' : 'Camada'} ${i.camada} · ${i.estado === 'publicado' ? (exp ? 'experimental' : (en ? 'published' : 'publicado')) : (en ? 'in construction' : 'em construção')}`;
---
<article class:list={['ind', `ind--${i.estado}`, { 'ind--exp': exp }]} id={`ind-${i.codigo.replace('.', '-')}`}>
  <header class="ind__head">
    <span class="ind__cod mono">{i.codigo}</span>
    <H class="ind__nome">{i.nome[k]}</H>
    <span class:list={['ind__selo', { 'ind__selo--exp': exp }]}>{selo}</span>
  </header>
  <Formula latex={i.formula} rotulo={`${i.codigo} — ${i.nome[k]}`} />
  <p class="ind__desc">{i.descricao[k]}</p>
  {i.convencao && <p class="ind__conv"><strong>{en ? 'Convention: ' : 'Convenção: '}</strong>{i.convencao[k]}</p>}
  {i.arquivo
    ? <p class="ind__dl"><a href={href(`/dados/opm/${i.arquivo}`)} download>{i.arquivo.split('/').pop()}</a></p>
    : <p class="ind__dl meta">{en ? 'No figure published. ' : 'Nenhuma cifra publicada. '}{i.pendencia?.[k]}</p>}
</article>
<style>
  .ind { border: 1px solid var(--pub-linha); border-top: 2px solid var(--pub-destaque); background: var(--pub-fundo); padding: var(--e-2); display: grid; gap: 12px; min-width: 0; align-content: start; }
  .ind--em-construcao { border-top-color: var(--pub-linha-forte); }
  .ind--exp { border-top-style: dashed; }
  .ind__head { display: grid; grid-template-columns: auto 1fr; gap: var(--s-1) var(--s-3); align-items: baseline; }
  .ind__cod { color: var(--pub-suave); font: 600 var(--t-12) / 1 var(--sans); }
  .ind__nome { margin: 0; font: 600 var(--t-16) / 1.3 var(--sans); color: var(--pub-tinta); }
  .ind__selo { grid-column: 1 / -1; justify-self: start; font: 600 10.5px / 1 var(--sans); letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 6px; border: 1px solid var(--pub-linha-forte); color: var(--pub-suave); }
  .ind__selo--exp { border-style: dashed; color: var(--ink); }
  .ind__desc, .ind__conv, .ind__dl { margin: 0; font-size: var(--t-14); line-height: 1.55; color: var(--pub-tinta); }
  .ind__conv, .ind__dl { color: var(--pub-suave); font-size: var(--t-12); }
  .ind__dl a { color: var(--pub-link); }
</style>
