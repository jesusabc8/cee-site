---
/** Ficha de indicador do OPM, gerada de src/data/opm/indicadores.yaml; fórmula em MathML (build). */
import Formula from './Formula.astro';
import { href } from '../../i18n/routing';
import type { Indicador } from '../../lib/opm-dados';
import type { Lang } from '../../i18n/ui';
interface Props { i: Indicador; lang: Lang; nivel?: 'h3' | 'h4' }
const { i, lang, nivel = 'h3' } = Astro.props;
const H = nivel;
const k = lang === 'en' ? 'en' : 'pt';
const en = k === 'en';
const selo = i.estado === 'publicado' ? (en ? 'Layer 1 · published' : 'Camada 1 · publicado')
  : i.estado === 'camada-2' ? (en ? 'Layer 2 · in construction' : 'Camada 2 · em construção')
  : (en ? 'Layer 3 · experimental' : 'Camada 3 · experimental');
---
<article class:list={['ind', `ind--${i.estado}`]} id={`ind-${i.codigo.replace('.', '-')}`}>
  <header class="ind__head">
    <span class="ind__cod mono">{i.codigo}</span>
    <H class="ind__nome">{i.nome[k]}</H>
    <span class:list={['ind__selo', { 'ind__selo--exp': i.estado === 'camada-3' }]}>{selo}</span>
  </header>
  <Formula latex={i.formula} rotulo={`${i.codigo} — ${i.nome[k]}`} />
  <p class="ind__desc">{i.descricao[k]}</p>
  {i.convencao && <p class="ind__conv"><strong>{en ? 'Convention: ' : 'Convenção: '}</strong>{i.convencao[k]}</p>}
  {i.arquivo
    ? <p class="ind__dl mono"><a href={href(`/dados/opm/${i.arquivo}`)} download>{i.arquivo.split('/').pop()}</a></p>
    : <p class="ind__dl meta">{en ? 'No data published yet: no figure is shown until the layer is complete.' : 'Sem dados publicados ainda: nenhuma cifra aparece até a camada estar concluída.'}</p>}
</article>
<style>
  .ind { border-top: 3px solid var(--navy); background: var(--paper, #fff); padding: var(--s-4); display: grid; gap: var(--s-3); min-width: 0; }
  .ind--camada-2 { border-top-color: var(--slate, #8AA4B3); }
  .ind--camada-3 { border-top-color: var(--steel, #4A7C96); border-top-style: dashed; }
  .ind__head { display: grid; grid-template-columns: auto 1fr; gap: var(--s-1) var(--s-3); align-items: baseline; }
  .ind__cod { color: var(--petrol); font-weight: 500; }
  .ind__nome { margin: 0; font-size: var(--step-0); line-height: 1.3; }
  .ind__selo { grid-column: 1 / -1; justify-self: start; font: 500 10px / 1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 6px; border: 1px solid var(--line-strong); color: var(--muted); }
  .ind__selo--exp { border-style: dashed; color: var(--ink); }
  .ind__desc, .ind__conv, .ind__dl { margin: 0; font-size: var(--step--1); }
  .ind__conv { color: var(--muted); }
</style>
