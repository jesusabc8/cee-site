---
/**
 * Visão geral do Observatório de Política Monetária (painel A2, edição 2.0; ADR-022, ADR-029): indicadores-chave,
 * mensagens-chave, calendário do Copom, gráficos em destaque, módulos, indicadores, conferência com o estado de
 * partida (Anexo B), metodologia, downloads, histórico e citação.
 */
import { getEntry } from 'astro:content';
import OpmShell from './OpmShell.astro';
import KpiStrip from './KpiStrip.astro';
import Mensagens from './Mensagens.astro';
import Ficha from './Ficha.astro';
import { ESTADO_PARTIDA, INDICADORES, INDICADORES_ESPEC, MODULOS } from '../../lib/opm-dados';
import { calendarioCopom, graficosModulo, kpisOpm, mensagensOpm, OPM_SLUG, rotDia, valoresCee, vintagesOpm } from '../../lib/opm';
import { fmtNum } from '../../lib/viz/render';
import { fmtDate, isoDate } from '../../lib/publicacoes';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const en = k === 'en';
const painel = (await getEntry('paineis', 'politica-monetaria'))!;
const p = painel.data;
const cee = valoresCee();
const cal = calendarioCopom();
const n2 = (v: number) => fmtNum(v, 2, lang);
const fd = (iso: string) => rotDia(Date.parse(`${iso}T00:00:00Z`), lang);
/** Intervalo de datas compacto: "8–9 dez 2026"; "30 jun – 1 jul 2026" quando o mês muda. */
const faixa = (a: string, b: string) => { const A = fd(a).split(' '), B = fd(b).split(' '); return A[1] === B[1] && A[2] === B[2] ? `${A[0]}–${B.join(' ')}` : `${A[0]} ${A[1]} – ${B.join(' ')}`; };
const vint = Object.values(vintagesOpm()).map((v) => v.extraido_em).sort().at(-1)!;
const opm = en ? 'Monetary Policy Observatory' : 'Observatório de Política Monetária';
const url = new URL(href(OPM_SLUG), Astro.site).href;
const citacao = `CENTRO DE ESTUDOS ECONÔMICOS (CEE). Observatório de Política Monetária. Observatório CEE — Economia Brasileira em Dados, ${p.linha}. Edição ${p.versao}. Dados extraídos em ${vint.slice(0, 10)}. Belo Horizonte: CEE, ${vint.slice(0, 4)}. Disponível em: ${url}.`;
const destaque = [
  graficosModulo('a2-2-juro-real', lang).graficos.find((g) => g.id === 'opm-juro-real')!,
  graficosModulo('a2-3-inflacao', lang).graficos.find((g) => g.id === 'opm-ipca-nucleos')!,
].map((g) => ({ ...g, largo: false, id: `${g.id}-destaque` }));
const proximas = cal.filter((c) => !c.realizada).slice(0, 4);
const ultimas = cal.filter((c) => c.realizada).slice(-3).reverse();
const conta = (id: string) => INDICADORES_ESPEC.filter((i) => i.modulo === id && i.estado === 'publicado').length;
const selo = (i: { estado: string; camada: number }) => (i.estado === 'publicado' ? (i.camada === 3 ? (en ? 'Experimental' : 'Experimental') : (en ? 'Published' : 'Publicado')) : (en ? 'In construction' : 'Em construção'));
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Dataset', name: `${p.linha}. ${opm}`, description: p.resumo[k], version: p.versao,
  dateModified: vint.slice(0, 10), license: 'https://creativecommons.org/licenses/by/4.0/', url, isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Centro de Estudos Econômicos (CEE)' },
  distribution: INDICADORES.filter((i) => i.arquivo).map((i) => ({ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(href(`/dados/opm/${i.arquivo}`), Astro.site).href })),
};
---
<OpmShell lang={lang} ativo="visao" titulo={opm} tituloPagina={`${p.linha}. ${opm}`} descricao={p.resumo[k]}
  lede={en ? 'How monetary policy is conducted in Brazil under inflation targeting: Copom decisions, real and neutral rates, inflation, expectations, transmission and money, measured with public formulas, open data and stored vintages.'
    : 'Como se conduz a política monetária no Brasil sob o regime de metas: decisões do Copom, juro real e neutro, inflação, expectativas, transmissão e moeda, medidos com fórmulas públicas, dados abertos e safras guardadas.'}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <KpiStrip itens={kpisOpm(lang)} lang={lang} />

  <div class="g12">
    <div class="c8"><Mensagens itens={mensagensOpm(lang)} lang={lang} data={rotDia(Date.parse(vint), lang)} /></div>
    <aside class="c4 cal" aria-labelledby="cal-t">
      <h2 id="cal-t" class="bloco-tit">{en ? 'Copom calendar' : 'Calendário do Copom'}</h2>
      <p class="cal__sub">{en ? 'Next meetings' : 'Próximas reuniões'}</p>
      <ul class="cal__lista">{proximas.map((c) => <li><span class="cal__rot">{c.rotulo}</span><time datetime={c.fim}>{faixa(c.inicio, c.fim)}</time></li>)}</ul>
      <p class="cal__sub">{en ? 'Latest decisions' : 'Últimas decisões'}</p>
      <ul class="cal__lista">{ultimas.map((c) => <li><span class="cal__rot">{c.reuniao}ª</span><time datetime={c.fim}>{fd(c.fim)}</time><b>{c.meta !== null ? `${n2(c.meta)}%` : '—'}</b></li>)}</ul>
      <p class="nota">{en ? 'BCB, Comunicados 43,383 and 45,452; interest-rate history.' : 'BCB, Comunicados nº 43.383 e nº 45.452; histórico de taxas de juros.'} <a href={href(`${OPM_SLUG}a2-1-copom/`, lang)}>{en ? 'Decisions and surprises' : 'Decisões e surpresas'} →</a></p>
    </aside>
  </div>

  <section aria-labelledby="dest-t">
    <div class="sec-cab"><h2 id="dest-t" class="sec-tit">{en ? 'Highlights' : 'Em destaque'}</h2></div>
    <div class="g12 fichas">{destaque.map((g) => <div class="c6"><Ficha g={g} lang={lang} /></div>)}</div>
  </section>

  <section aria-labelledby="mod-t">
    <div class="sec-cab"><h2 id="mod-t" class="sec-tit">{en ? 'Modules' : 'Módulos'}</h2><p class="sec-nota">{en ? 'Eight modules, 21 indicators with public formulas' : 'Oito módulos, 21 indicadores com fórmula pública'}</p></div>
    <ol class="mods">
      {MODULOS.map((m) => (
        <li><a class="mods__a" href={href(`${OPM_SLUG}${m.id}/`, lang)}>
          <span class="mods__c">{m.codigo}</span><span class="mods__t">{m.titulo[k]}</span>
          <span class="mods__q">{m.pergunta[k]}</span>
          <span class="mods__n">{conta(m.id)} {en ? (conta(m.id) === 1 ? 'published indicator' : 'published indicators') : (conta(m.id) === 1 ? 'indicador publicado' : 'indicadores publicados')}</span>
        </a></li>
      ))}
    </ol>
  </section>

  <div class="g12">
    <section class="c7" aria-labelledby="inds-t">
      <div class="sec-cab"><h2 id="inds-t" class="sec-tit">{en ? 'The 21 indicators' : 'Os 21 indicadores'}</h2></div>
      <div class="table-scroll" role="region" aria-label={en ? 'Table: indicators' : 'Tabela: indicadores'} tabindex="0">
        <table class="tab">
          <thead><tr><th scope="col">Nº</th><th scope="col">{en ? 'Indicator' : 'Indicador'}</th><th scope="col">{en ? 'Module' : 'Módulo'}</th><th scope="col">{en ? 'Layer' : 'Camada'}</th><th scope="col">{en ? 'Status' : 'Situação'}</th></tr></thead>
          <tbody>{INDICADORES_ESPEC.map((i) => {
            const m = MODULOS.find((x) => x.id === i.modulo)!;
            return <tr><th scope="row">{i.codigo}</th><td><a href={href(`${OPM_SLUG}${m.id}/#ind-${i.codigo.replace('.', '-')}`, lang)}>{i.nome[k]}</a></td><td>{m.codigo}</td><td class="num">{i.camada}</td><td><span class:list={['chip', `chip--${i.estado}`, { 'chip--exp': i.camada === 3 && i.estado === 'publicado' }]}>{selo(i)}</span></td></tr>;
          })}</tbody>
        </table>
      </div>
    </section>
    <section class="c5" aria-labelledby="ep-t">
      <div class="sec-cab"><h2 id="ep-t" class="sec-tit">{en ? 'Starting point check' : 'Conferência com o estado de partida'}</h2></div>
      <p class="nota">{en ? 'BCB figures (specification, Annex B) and the same figures computed by CEE from the archived data. Rows without a CEE value are BCB references, shown beside the CEE measures.' : 'Valores do BCB (especificação, Anexo B) e os mesmos valores calculados pelo CEE com os dados arquivados. Linhas sem valor do CEE são referências do BCB, mostradas ao lado das medidas do CEE.'}</p>
      <div class="table-scroll" role="region" aria-label={en ? 'Table: starting point' : 'Tabela: estado de partida'} tabindex="0">
        <table class="tab tab--comp">
          <thead><tr><th scope="col">{en ? 'Item' : 'Item'}</th><th scope="col" class="num">BCB</th><th scope="col" class="num">CEE</th><th scope="col" class="num">{en ? 'Diff.' : 'Dif.'}</th></tr></thead>
          <tbody>{ESTADO_PARTIDA.map((e) => {
            const v = e.cee ? cee[e.cee] ?? null : null;
            return <tr><th scope="row">{e.rotulo[k]}<span class="fonte">{e.fonte}</span></th><td class="num">{n2(e.bcb)}</td><td class="num">{v === null ? '—' : n2(v)}</td><td class="num">{v === null ? '—' : n2(v - e.bcb)}</td></tr>;
          })}</tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="g12">
    <section class="c7" id="metodologia" aria-labelledby="met-t">
      <div class="sec-cab"><h2 id="met-t" class="sec-tit">{en ? 'Methodological note' : 'Nota metodológica'}</h2></div>
      <div class="texto">
        <p>{p.metodologia?.[k]}</p>
        <p><a href={href('/observatorio/catalogo/', lang)}>{en ? 'Data and source catalogue' : 'Catálogo de dados e fontes'}</a> · <a href={href(`${OPM_SLUG}safras/`, lang)}>{en ? 'Archived vintages' : 'Safras arquivadas'}</a> · {p.codigo_url ? <a href={p.codigo_url}>{en ? 'Code' : 'Código'}</a> : <span>{en ? 'Code available from CEE on request.' : 'Código disponível mediante solicitação ao CEE.'}</span>}</p>
      </div>
    </section>
    <div class="c5 lateral">
      <section id="citar" aria-labelledby="cit-t">
        <h2 id="cit-t" class="bloco-tit">{en ? 'How to cite' : 'Como citar'}</h2>
        <p class="cite">{citacao}</p>
        {!p.doi && <p class="nota">{en ? 'No DOI yet.' : 'DOI ainda não atribuído.'}</p>}
      </section>
      <section aria-labelledby="ch-t">
        <h2 id="ch-t" class="bloco-tit">{en ? 'Change log' : 'Histórico de mudanças'}</h2>
        <ol class="hist">{p.changelog.map((c) => <li><span class="hist__d"><time datetime={isoDate(c.data)}>{fmtDate(c.data, lang, 'short')}</time> · {en ? 'Edition' : 'Edição'} {c.versao}</span> {c.nota}</li>)}</ol>
        <p class="nota"><a href={href(`${OPM_SLUG}dados/`, lang)}>{en ? 'All downloads' : 'Todos os downloads'} →</a></p>
      </section>
    </div>
  </div>
</OpmShell>

<style>
  .g12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--e-4); align-items: start; }
  .c4 { grid-column: span 4; } .c5 { grid-column: span 5; } .c6 { grid-column: span 6; } .c7 { grid-column: span 7; } .c8 { grid-column: span 8; }
  .fichas { align-items: stretch; }
  .fichas > div { display: grid; }
  .sec-cab { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; margin-bottom: var(--e-2); padding-bottom: 8px; border-bottom: 1px solid var(--pub-linha); }
  .sec-tit { margin: 0; font: 600 var(--t-28) / 1.2 var(--serif); color: var(--pub-tinta); }
  .sec-nota { margin: 0; font-size: var(--t-14); color: var(--pub-suave); }
  .bloco-tit { margin: 0 0 var(--e-1); font: 600 var(--t-18) / 1.3 var(--serif); color: var(--pub-tinta); }
  .nota { margin: var(--e-1) 0 0; font-size: var(--t-12); line-height: 1.5; color: var(--pub-suave); }
  .nota a, .texto a, .tab a { color: var(--pub-link); }
  .cal { border-top: 2px solid var(--pub-destaque); padding-top: var(--e-2); }
  .cal__sub { margin: var(--e-2) 0 4px; font: 600 var(--t-12) / 1.3 var(--sans); text-transform: uppercase; letter-spacing: 0.04em; color: var(--pub-suave); }
  .cal__lista { list-style: none; margin: 0; padding: 0; font-size: var(--t-14); font-variant-numeric: tabular-nums; }
  .cal__lista li { display: flex; gap: 12px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--pub-linha); }
  .cal__rot { min-width: 4.5em; font-weight: 600; color: var(--pub-tinta); }
  .cal__lista b { margin-left: auto; }
  .mods { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--pub-linha); border: 1px solid var(--pub-linha); }
  .mods__a { display: grid; grid-template-rows: auto auto 1fr auto; gap: 6px; height: 100%; padding: var(--e-2) var(--e-2) 12px; background: var(--pub-fundo); color: inherit; text-decoration: none; }
  .mods__a:hover { background: var(--pub-superficie); }
  .mods__a:hover .mods__t { text-decoration: underline; }
  .mods__a:focus-visible { outline: 2px solid var(--pub-link); outline-offset: -2px; }
  .mods__c { font: 600 var(--t-12) / 1 var(--sans); color: var(--pub-suave); letter-spacing: 0.04em; }
  .mods__t { font: 600 var(--t-18) / 1.25 var(--serif); color: var(--pub-tinta); }
  .mods__q { font-size: var(--t-14); line-height: 1.45; color: var(--pub-suave); }
  .mods__n { font: 500 var(--t-12) / 1.3 var(--sans); color: var(--pub-link); }
  .tab { border-collapse: collapse; width: 100%; font-size: var(--t-14); font-variant-numeric: tabular-nums; }
  .tab th, .tab td { text-align: left; padding: 7px 12px 7px 0; border-top: 1px solid var(--pub-linha); vertical-align: top; }
  .tab thead th { border-top: 0; border-bottom: 1px solid var(--pub-linha-forte); font: 600 var(--t-12) / 1.3 var(--sans); text-transform: uppercase; letter-spacing: 0.03em; color: var(--pub-suave); }
  .tab tbody th { font-weight: 500; }
  .tab .num { text-align: right; white-space: nowrap; }
  .tab--comp tbody th { font-weight: 400; }
  .fonte { display: block; font-size: var(--t-12); color: var(--pub-suave); }
  .chip { display: inline-block; font: 600 10.5px / 1 var(--sans); letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 6px; border: 1px solid var(--pub-linha-forte); white-space: nowrap; color: var(--pub-suave); }
  .chip--publicado { border-color: var(--pub-destaque); color: var(--pub-destaque); }
  .chip--exp { border-style: dashed; color: var(--pub-tinta); }
  .texto p { margin: 0 0 var(--e-2); font: 400 var(--t-16) / 1.65 var(--serif); color: var(--pub-tinta); max-width: 75ch; }
  .lateral { display: grid; gap: var(--e-4); }
  .cite { margin: 0; overflow-wrap: anywhere; font: 400 var(--t-14) / 1.55 var(--serif); background: var(--pub-superficie); border-left: 3px solid var(--pub-linha-forte); padding: 12px 14px; }
  .hist { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: var(--t-14); line-height: 1.5; }
  .hist__d { display: block; font-size: var(--t-12); color: var(--pub-suave); }
  @media (max-width: 64rem) {
    .c4, .c5, .c6, .c7, .c8 { grid-column: 1 / -1; }
    .mods { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) { .g12 { gap: var(--e-3); } .mods { grid-template-columns: minmax(0, 1fr); } .sec-tit { font-size: var(--t-22); } }
</style>
