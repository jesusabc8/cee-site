---
/** Faixa de indicadores-chave: valor, variação, minigráfico e data de referência própria de cada série (ADR-029). */
import type { Kpi } from '../../lib/opm';
import { fmtNum } from '../../lib/viz/render';
import type { Lang } from '../../i18n/ui';
interface Props { itens: Kpi[]; lang: Lang }
const { itens, lang } = Astro.props;
const en = lang === 'en';
const spark = (v: number[]) => {
  if (v.length < 2) return '';
  const w = 120, h = 32, mn = Math.min(...v), mx = Math.max(...v), r = mx - mn || 1;
  const p = v.map((y, i) => [(i * w) / (v.length - 1), h - 3 - ((y - mn) / r) * (h - 6)]);
  const d = p.map(([x, y], i) => `${i ? 'L' : 'M'}${x!.toFixed(1)} ${y!.toFixed(1)}`).join('');
  const [lx, ly] = p.at(-1)!;
  return `<svg class="kpi__spark" viewBox="-3 -3 ${w + 6} ${h + 6}" aria-hidden="true" focusable="false"><path d="${d}" class="kpi__linha"/><circle cx="${lx!.toFixed(1)}" cy="${ly!.toFixed(1)}" r="2.6" class="kpi__ponto"/></svg>`;
};
---
<section class="kpis" aria-labelledby="kpis-t">
  <h2 id="kpis-t" class="visually-hidden">{en ? 'Key indicators' : 'Indicadores-chave'}</h2>
  <ul class="kpis__grade">
    {itens.map((k) => {
      const d = k.anterior === null ? null : k.valor - k.anterior;
      const seta = d === null || Math.abs(d) < 0.005 ? '■' : d > 0 ? '▲' : '▼';
      const dTxt = d === null ? '' : `${d > 0 ? '+' : d < 0 ? '−' : '±'}${fmtNum(Math.abs(d), k.digitos, lang)}${k.deltaUnid ? ` ${k.deltaUnid}` : ''}`;
      return (
        <li class="kpi">
          <a href={k.href} class="kpi__link">
            <span class="kpi__rot">{k.rotulo}</span>
            <span class="kpi__val">{fmtNum(k.valor, k.digitos, lang)}{k.sufixo}</span>
            {d !== null && <span class="kpi__delta"><span aria-hidden="true">{seta}</span> {dTxt} <span class="visually-hidden">{en ? 'versus previous observation' : 'em relação à observação anterior'}</span></span>}
            <Fragment set:html={spark(k.serie)} />
            <span class="kpi__ref">{k.ref}</span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
<style>
  .kpis__grade { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--pub-linha); border-left: 1px solid var(--pub-linha); }
  .kpi { border-right: 1px solid var(--pub-linha); border-bottom: 1px solid var(--pub-linha); min-width: 0; }
  .kpi__link { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'rot rot' 'val spark' 'delta spark' 'ref ref'; gap: 2px 12px; padding: var(--e-2) var(--e-2) 12px; color: inherit; text-decoration: none; height: 100%; }
  .kpi__link:hover { background: var(--pub-superficie); }
  .kpi__link:focus-visible { outline: 2px solid var(--pub-link); outline-offset: -2px; }
  .kpi__rot { grid-area: rot; font: 600 var(--t-12) / 1.3 var(--sans); letter-spacing: 0.03em; text-transform: uppercase; color: var(--pub-suave); }
  .kpi__val { grid-area: val; font: 600 var(--t-28) / 1.15 var(--sans); font-variant-numeric: tabular-nums; color: var(--pub-tinta); letter-spacing: -0.01em; }
  .kpi__delta { grid-area: delta; font: 500 var(--t-12) / 1.3 var(--sans); font-variant-numeric: tabular-nums; color: var(--pub-suave); }
  .kpi__ref { grid-area: ref; margin-top: 4px; font: 400 var(--t-12) / 1.3 var(--sans); color: var(--pub-suave); }
  .kpi :global(.kpi__spark) { grid-area: spark; align-self: center; width: 96px; height: auto; }
  .kpi :global(.kpi__linha) { fill: none; stroke: var(--s2); stroke-width: 1.6; stroke-linejoin: round; }
  .kpi :global(.kpi__ponto) { fill: var(--s1); }
  @media (max-width: 64rem) { .kpis__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) {
    .kpi__link { grid-template-columns: 1fr; grid-template-areas: 'rot' 'val' 'delta' 'spark' 'ref'; padding: 12px; }
    .kpi :global(.kpi__spark) { width: 100%; max-width: 160px; margin-top: 4px; }
    .kpi__val { font-size: var(--t-22); }
  }
</style>
