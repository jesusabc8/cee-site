---
/** Página de módulo do OPM (A2.1–A2.8), no sistema visual de publicação (ADR-029). */
import OpmShell from './OpmShell.astro';
import Ficha from './Ficha.astro';
import IndicadorCard from './IndicadorCard.astro';
import SeletorDessaz from './SeletorDessaz.astro';
import { INDICADORES, MODULOS, type Modulo } from '../../lib/opm-dados';
import { graficosModulo, OPM_SLUG } from '../../lib/opm';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { modulo: Modulo; lang: Lang }
const { modulo, lang } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const en = k === 'en';
const { graficos, dessaz, tabelas } = graficosModulo(modulo.id, lang);
// Fichas meias em pares; uma meia sem par numa linha vira larga (sem lacuna ao lado).
const layout = (() => {
  const out: { g: (typeof graficos)[number]; larga: boolean }[] = [];
  let pend: (typeof graficos)[number][] = [];
  const fecha = () => { pend.forEach((g, i) => out.push({ g, larga: pend.length % 2 === 1 && i === pend.length - 1 })); pend = []; };
  for (const g of graficos) { if (g.largo) { fecha(); out.push({ g, larga: true }); } else pend.push(g); }
  fecha();
  return out;
})();
const inds = INDICADORES.filter((i) => i.modulo === modulo.id);
const pos = MODULOS.findIndex((m) => m.id === modulo.id);
const ant = MODULOS[pos - 1], prox = MODULOS[pos + 1];
---
<OpmShell lang={lang} ativo={modulo.id} titulo={`${modulo.codigo} ${modulo.titulo[k]}`} descricao={modulo.pergunta[k]} lede={modulo.pergunta[k]}
  principio={en ? 'The OPM describes and measures; it does not recommend the Selic rate. Neutral rates, gaps and policy rules are shown as bands, with method and date.' : 'O OPM descreve e mede; não recomenda a taxa Selic. Juro neutro, hiatos e regras de política aparecem como faixas, com método e data.'}
  sobretitulo={en ? 'Monetary Policy Observatory · Panel A2' : 'Observatório de Política Monetária · Painel A2'}>


  {layout.length > 0 && (
    <section aria-label={en ? 'Charts' : 'Gráficos'} class="g12 fichas">
      {layout.map(({ g, larga }) => <div class={larga ? 'c12' : 'c6'}><Ficha g={larga ? { ...g, largo: true } : g} lang={lang} nivel="h2" /></div>)}
    </section>
  )}

  {modulo.id === 'a2-7-projecoes' && (
    <aside class="aviso">
      <h2 class="bloco-tit">{en ? 'What this module does' : 'O que este módulo faz'}</h2>
      <p>{en
        ? 'It records and compares BCB and Focus projections and, once each outcome is known, their forecast errors, using the vintages stored since this edition. CEE scenarios from the semi-structural model are conditional exercises and are published only if the model passes the identification test below (ADR-028); they are never CEE forecasts.'
        : 'Registra e compara as projeções do BCB e da Focus e, conhecido cada dado, seus erros de previsão, com as safras guardadas desde esta edição. Os cenários do CEE com o modelo semiestrutural são exercícios condicionais e só são publicados se o modelo passar no critério de identificação abaixo (ADR-028); nunca são previsão do CEE.'}</p>
    </aside>
  )}

  {tabelas?.map((t) => (
    <section class="tabela" aria-labelledby={`${t.id}-t`} id={t.id}>
      <div class="sec-cab"><h2 id={`${t.id}-t`} class="sec-tit sec-tit--m">{t.titulo}</h2></div>
      <p class="nota nota--larga">{t.descricao}</p>
      <div class="table-scroll" role="region" aria-label={`${en ? 'Table' : 'Tabela'}: ${t.titulo}`} tabindex="0">
        <table class="tab">
          <thead><tr>{t.colunas.map((c, i) => <th scope="col" class={i ? 'num' : undefined}>{c}</th>)}</tr></thead>
          <tbody>{t.linhas.map((l) => <tr>{l.map((v, i) => (i === 0 ? <th scope="row">{v}</th> : <td class="num">{v}</td>))}</tr>)}</tbody>
        </table>
      </div>
      <p class="nota">{en ? 'Source' : 'Fonte'}: {t.fontes.map((f, i) => <>{i > 0 && '; '}<a href={f.url}>{f.instituicao === 'Banco Central do Brasil' ? 'BCB' : f.instituicao}</a>, {f.codigo}</>)}. {en ? 'Data' : 'Dados'}: {t.csv.map((c, i) => <>{i > 0 && ' · '}<a href={c.href} download>{c.rotulo}</a></>)}</p>
    </section>
  ))}

  {dessaz && dessaz.length > 0 && (
    <section aria-labelledby="dessaz-t">
      <div class="sec-cab">
        <h2 id="dessaz-t" class="sec-tit sec-tit--m">{en ? 'Original and seasonally adjusted series' : 'Séries original e dessazonalizada'}</h2>
        <p class="sec-nota">{en ? 'X-13ARIMA-SEATS by CEE (ADR-023); the adjusted series is an estimate, revised with each new data point' : 'X-13ARIMA-SEATS pelo CEE (ADR-023); a série ajustada é estimativa, revista a cada novo dado'}</p>
      </div>
      <div class="g12">
        {dessaz.map((d, n) => <div class="c6"><SeletorDessaz id={`sel-${modulo.id}-${n}`} titulo={d.titulo} original={d.original} ajustada={d.ajustada} lang={lang} /></div>)}
      </div>
    </section>
  )}

  <section aria-labelledby="ind-t">
    <div class="sec-cab"><h2 id="ind-t" class="sec-tit sec-tit--m">{en ? 'Indicators and formulas' : 'Indicadores e fórmulas'}</h2></div>
    {inds.length
      ? <div class="inds">{inds.map((i) => <IndicadorCard i={i} lang={lang} />)}</div>
      : <p class="nota">{en ? 'This module uses source series only; the specification assigns it no CEE indicator.' : 'Este módulo usa só séries das fontes; a especificação não lhe atribui indicador do CEE.'}</p>}
  </section>

  <nav class="modnav" aria-label={en ? 'Previous and next module' : 'Módulo anterior e seguinte'}>
    {ant ? <a href={href(`${OPM_SLUG}${ant.id}/`, lang)}><span>{en ? 'Previous' : 'Anterior'}</span>← {ant.codigo} {ant.titulo[k]}</a> : <span />}
    {prox ? <a class="modnav__prox" href={href(`${OPM_SLUG}${prox.id}/`, lang)}><span>{en ? 'Next' : 'Seguinte'}</span>{prox.codigo} {prox.titulo[k]} →</a> : <span />}
  </nav>
</OpmShell>

<style>
  .g12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--e-4); }
  .c6 { grid-column: span 6; min-width: 0; display: grid; } .c12 { grid-column: 1 / -1; min-width: 0; display: grid; }
  .principio { margin: 0; max-width: 90ch; padding: 10px 14px; background: var(--pub-superficie); border-left: 3px solid var(--pub-linha-forte); font-size: var(--t-14); line-height: 1.5; color: var(--pub-suave); }
  .sec-cab { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; margin-bottom: var(--e-2); padding-bottom: 8px; border-bottom: 1px solid var(--pub-linha); }
  .sec-tit { margin: 0; font: 600 var(--t-28) / 1.2 var(--serif); color: var(--pub-tinta); }
  .sec-tit--m { font-size: var(--t-22); }
  .sec-nota { margin: 0; font-size: var(--t-12); color: var(--pub-suave); max-width: 60ch; }
  .bloco-tit { margin: 0 0 var(--e-1); font: 600 var(--t-18) / 1.3 var(--serif); color: var(--pub-tinta); }
  .nota { margin: var(--e-1) 0 0; font-size: var(--t-12); line-height: 1.5; color: var(--pub-suave); overflow-wrap: anywhere; }
  .nota--larga { font-size: var(--t-14); max-width: 95ch; margin: 0 0 var(--e-2); }
  .nota a { color: var(--pub-link); }
  .aviso { padding: var(--e-2) var(--e-3); background: var(--pub-superficie); border-top: 2px solid var(--pub-destaque); }
  .aviso p { margin: 0; max-width: 95ch; font: 400 var(--t-16) / 1.6 var(--serif); }
  .tab { border-collapse: collapse; width: 100%; font-size: var(--t-14); font-variant-numeric: tabular-nums; }
  .tab th, .tab td { text-align: left; padding: 6px 14px 6px 0; border-top: 1px solid var(--pub-linha); }
  .tab thead th { border-top: 0; border-bottom: 1px solid var(--pub-linha-forte); font: 600 var(--t-12) / 1.3 var(--sans); text-transform: uppercase; letter-spacing: 0.03em; color: var(--pub-suave); }
  .tab tbody th { font-weight: 500; }
  .tab .num { text-align: right; white-space: nowrap; }
  .inds { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: var(--e-3); align-items: start; }
  .modnav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--e-2); padding-top: var(--e-2); border-top: 1px solid var(--pub-linha); font: 500 var(--t-14) / 1.4 var(--sans); }
  .modnav a { display: grid; gap: 2px; color: var(--pub-link); text-decoration: none; }
  .modnav a span { font-size: var(--t-12); color: var(--pub-suave); text-transform: uppercase; letter-spacing: 0.04em; }
  .modnav a:hover { text-decoration: underline; }
  .modnav__prox { text-align: right; }
  @media (max-width: 64rem) { .c6 { grid-column: 1 / -1; } }
  @media (max-width: 40rem) { .g12 { gap: var(--e-3); } .sec-tit, .sec-tit--m { font-size: var(--t-22); } }
</style>
