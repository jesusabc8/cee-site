---
import { config } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';
import { href } from '../i18n/routing';
import Disclaimer from './Disclaimer.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const cols = [
  {
    title: t('footer.institucional'),
    links: [
      { href: href('/sobre/', lang), label: t('nav.sobre') },
      { href: href('/metodologia/', lang), label: t('nav.metodologia') },
      { href: href('/participe/', lang), label: t('nav.participe') },
      { href: href('/equipe/', lang), label: t('nav.equipe') },
      { href: href('/contato/', lang), label: t('footer.contato') },
    ],
  },
  {
    title: t('footer.politicas'),
    links: [
      { href: href('/erratas/', lang), label: t('footer.erratas') },
      { href: href('/privacidade/', lang), label: t('footer.privacidade') },
      { href: href('/termos/', lang), label: t('footer.termos') },
      { href: href('/acessibilidade/', lang), label: t('footer.acessibilidade') },
    ],
  },
  {
    title: t('footer.abertos'),
    links: [
      { href: href('/observatorio/catalogo/', lang), label: t('footer.catalogo') },
      { href: config.repoUrl, label: t('footer.repo') },
      { href: href('/rss.xml'), label: t('footer.rss') },
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__id">
        <p class="site-footer__brand">{config.sigla} · {t('site.name')}</p>
        <p class="meta">{t('site.tagline')}.</p>
      </div>
      <nav aria-label={t('footer.institucional')} class="site-footer__nav">
        {cols.map((c) => (
          <div>
            <h2 class="eyebrow">{c.title}</h2>
            <ul>
              {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="site-footer__legal">
      <Disclaimer lang={lang} />
      <p class="meta">{t('footer.licenses')}</p>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-8);
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: var(--s-6) var(--s-7);
    font-size: var(--step--1);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 52rem) {
    .site-footer__grid { grid-template-columns: 1.2fr 2fr; }
  }
  .site-footer__brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: var(--s-2);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--s-5);
  }
  .site-footer__nav h2 { font-size: var(--step--2); margin-bottom: var(--s-2); }
  .site-footer__nav ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__nav li + li { margin-top: var(--s-1); }
  .site-footer__nav a { color: var(--text); text-decoration: none; }
  .site-footer__nav a:hover { color: var(--primary); text-decoration: underline; }
  .site-footer__legal {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: var(--hairline);
    display: grid;
    gap: var(--s-3);
  }
</style>
