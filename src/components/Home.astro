---
/**
 * Início: sem herói decorativo. Missão em uma frase, última publicação, Observatório,
 * últimas publicações, áreas e convite a participar. Blocos sem conteúdo real mostram estado honesto.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chart from './Chart.astro';
import PubRow from './pub/PubRow.astro';
import { graficosConjuntura } from '../lib/conjuntura';
import { getPublicacoes } from '../lib/publicacoes';
import { href } from '../i18n/routing';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const k = lang === 'en' ? 'en' : 'pt';
const pubs = await getPublicacoes();
const ultima = pubs[0];
const recentes = pubs.slice(1, 6);
const grafico = graficosConjuntura(lang).jurosInflacao;
const areas = (await getCollection('areas')).filter((a) => a.data.tipo === 'area').sort((a, b) => a.data.ordem - b.data.ordem);

const T = {
  pt: {
    missao: 'Análise econômica empírica sobre o Brasil, rigorosa, reprodutível e de acesso aberto — e a formação de estudantes de graduação nesse padrão.',
    regra: 'Nenhum número é publicado sem que outra pessoa reexecute o código e chegue ao mesmo resultado.',
    ultima: 'Última publicação', ultimaVazia: 'A primeira publicação do CEE está em preparação. Quando sair, aparecerá aqui, com dados, código e bloco de citação.',
    obs: 'Observatório de Dados', obsTxt: 'Séries econômicas brasileiras em formato limpo e versionado, com fonte, código da série e data de extração em cada gráfico.',
    obsVer: 'Ir para o Observatório',
    areas: 'Áreas de pesquisa', todas: 'Agenda completa',
    part: 'Participe', partTxt: 'A entrada é aberta a estudantes de Ciências Econômicas de qualquer campus e do EAD, sem seleção e sem pré-requisito. Cada pessoa começa com uma tarefa real e revisada.',
    partLink: 'Como participar', metodo: 'Como trabalhamos', recentes: 'Publicações recentes', todasPubs: 'Todas as publicações',
  },
  en: {
    missao: 'Rigorous, reproducible, open-access empirical economic analysis of Brazil — and training undergraduates to that standard.',
    regra: 'No number is published unless someone else re-runs the code and obtains the same result.',
    ultima: 'Latest publication', ultimaVazia: 'CEE\'s first publication is in preparation. It will appear here, with data, code and a citation block.',
    obs: 'Data Observatory', obsTxt: 'Clean, versioned Brazilian economic series, with source, series code and extraction date on every chart.',
    obsVer: 'Go to the Observatory',
    areas: 'Research areas', todas: 'Full agenda',
    part: 'Get involved', partTxt: 'Entry is open to Economics students from any campus and the distance-learning track, with no selection and no prerequisites. Everyone starts with a real, reviewed task.',
    partLink: 'How to get involved', metodo: 'How we work', recentes: 'Recent publications', todasPubs: 'All publications',
  },
}[k];
---
<Base title={t('site.name')} description={t('site.tagline')} lang={lang}>
  <div class="wrap">
    <section class="intro">
      <h1 class="visually-hidden">{t('site.name')}</h1>
      <p class="intro__missao">{T.missao}</p>
      <p class="intro__regra">{T.regra} <a href={href('/metodologia/', lang)}>{T.metodo}</a></p>
    </section>

    <div class="home-grid">
      <section class="section" aria-labelledby="h-ultima">
        <div class="section__head"><h2 id="h-ultima" class="section__title">{T.ultima}</h2></div>
        {ultima ? <PubRow pub={ultima} lang={lang} /> : <p class="meta">{T.ultimaVazia}</p>}
      </section>

      <section class="section" aria-labelledby="h-obs">
        <div class="section__head">
          <h2 id="h-obs" class="section__title">{T.obs}</h2>
          <a class="meta" href={href('/observatorio/', lang)}>{T.obsVer}</a>
        </div>
        <p class="meta obs-txt">{T.obsTxt}</p>
        <Chart {...grafico} lang={lang} />
      </section>
    </div>

    {recentes.length > 0 && (
      <section class="section" aria-labelledby="h-recentes">
        <div class="section__head">
          <h2 id="h-recentes" class="section__title">{T.recentes}</h2>
          <a class="meta" href={href('/publicacoes/', lang)}>{T.todasPubs}</a>
        </div>
        {recentes.map((p) => <PubRow pub={p} lang={lang} />)}
      </section>
    )}

    <section class="section" aria-labelledby="h-areas">
      <div class="section__head">
        <h2 id="h-areas" class="section__title">{T.areas}</h2>
        <a class="meta" href={href('/pesquisa/', lang)}>{T.todas}</a>
      </div>
      <ol class="areas">
        {areas.map((a) => (
          <li>
            <h3><a href={href(`/pesquisa/${a.id}/`, lang)}><span class="code">{a.data.codigo}</span> {a.data.nome[k]}</a></h3>
            <p>{a.data.pergunta_guia[k]}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section split" aria-labelledby="h-part">
      <h2 id="h-part" class="section__title">{T.part}</h2>
      <div class="prose">
        <p>{T.partTxt}</p>
        <p><a href={href('/participe/', lang)}>{T.partLink}</a></p>
      </div>
    </section>
  </div>
</Base>
<style>
  .intro { padding-block: var(--s-7) var(--s-6); max-width: 46rem; }
  .intro__missao { font-family: var(--font-serif); font-size: var(--step-4); line-height: 1.25; font-weight: 500; text-wrap: balance; }
  .intro__regra { margin-top: var(--s-4); color: var(--text-2); font-size: var(--step-0); }
  .home-grid { display: grid; gap: 0 var(--s-7); }
  @media (min-width: 60rem) { .home-grid { grid-template-columns: 1fr 2fr; } }
  .obs-txt { margin-bottom: var(--s-4); max-width: var(--measure); }
  .areas { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); }
  @media (min-width: 52rem) { .areas { grid-template-columns: repeat(3, 1fr); gap: var(--s-6); } }
  .areas li { border-top: 2px solid var(--primary); padding-top: var(--s-3); }
  .areas h3 { font-size: var(--step-2); }
  .areas h3 a { color: var(--text); text-decoration: none; }
  .areas h3 a:hover { color: var(--primary); text-decoration: underline; }
  .areas p { margin-top: var(--s-2); font-family: var(--font-serif); color: var(--text-2); }
  .code { color: var(--primary); margin-right: 0.15em; }
</style>
