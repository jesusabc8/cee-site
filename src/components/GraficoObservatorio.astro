---
/**
 * Atalho para usar um gráfico do Observatório em uma publicação MDX:
 *   import GraficoObservatorio from '../../components/GraficoObservatorio.astro';
 *   <GraficoObservatorio grafico="jurosInflacao" />
 * Gráficos disponíveis (painel Conjuntura): jurosInflacao, ipcaMensal, desocupacao, focus.
 */
import ChartCard from './charts/ChartCard.astro';
import { graficosConjuntura } from '../lib/conjuntura';
import type { Lang } from '../i18n/ui';

interface Props { grafico: 'jurosInflacao' | 'ipcaMensal' | 'desocupacao' | 'focus'; lang?: Lang }
const { grafico, lang = 'pt-BR' } = Astro.props;
const g = graficosConjuntura(lang)[grafico];
---
<ChartCard g={g} lang={lang} />
