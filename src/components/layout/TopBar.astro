---
/** Faixa institucional superior (44 px, carvão): linha institucional à esquerda, redes à direita. */
import { config } from '../../site.config';
import SocialIcons from '../ui/SocialIcons.astro';
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<aside class="topbar" aria-label={lang === 'en' ? 'Institution and social media' : 'Instituição e redes sociais'}>
  <div class="topbar__inner">
    <p class="topbar__line">{config.institutionalLine}</p>
    <SocialIcons lang={lang} />
  </div>
</aside>
<style>
  .topbar { background: var(--topbar); color: var(--white); }
  .topbar__inner {
    height: 44px;
    padding-inline: clamp(20px, 3vw, 40px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .topbar__line {
    font: 600 11.5px / 1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 40rem) {
    .topbar__line { font-size: 10px; letter-spacing: 0.08em; }
    .topbar :global(.socials) { gap: 14px; }
    .topbar :global(.socials svg) { width: 16px; height: 16px; }
  }
  @media (max-width: 30rem) {
    .topbar__line { font-size: 9px; line-height: 1.25; letter-spacing: 0.04em; white-space: normal; max-width: 24ch; }
  }
</style>
