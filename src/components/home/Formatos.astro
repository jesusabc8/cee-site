---
/**
 * Catálogo de produtos (Manual de Programas e Produtos, Parte II, Quadro 2) em quatro blocos, com finalidade,
 * extensão e revisão mínima. O estado vem das publicações existentes; sem publicação, estado honesto.
 */
import Icon from '../ui/Icon.astro';
import { getPublicacoes } from '../../lib/publicacoes';
import { href } from '../../i18n/routing';
import { BLOCOS, TIPOS, TIPO_KEYS, type Bloco, type Tipo } from '../../schemas/publicacao';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const k = en ? 'en' : 'pt';
const pubs = await getPublicacoes();
const conta = (t: Tipo) => pubs.filter((p) => p.data.tipo === t).length;
const ICONE: Record<Bloco, string> = { dados: 'database', pesquisa: 'book-open', comunicacao: 'megaphone', institucionais: 'landmark' };
const blocos = (Object.keys(BLOCOS) as Bloco[]).map((b) => ({ b, tipos: TIPO_KEYS.filter((t) => TIPOS[t].bloco === b) }));
const estado = (t: Tipo) => {
  const n = conta(t);
  return n > 0
    ? { txt: en ? `${n} published` : `${n} publicad${n > 1 ? 'os' : 'o'}`, vivo: true }
    : { txt: en ? 'No issue yet' : 'Nenhuma edição ainda', vivo: false };
};
---
<section class="formatos band-navy section" id="formatos" aria-labelledby="formatos-t">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">{en ? 'Publications' : 'Publicações'}</p>
        <h2 id="formatos-t">{en ? 'Outputs designed to be read and checked' : 'Produtos pensados para serem lidos e verificados'}</h2>
      </div>
      <p>{en
        ? 'Each output has a defined purpose, length and minimum review. Every number published must be re-runnable from the source data, and is checked by someone other than the authors.'
        : 'Cada produto tem finalidade, extensão e revisão mínima definidas. Todo número publicado deve ser reexecutável a partir dos dados de origem e é conferido por pessoa distinta dos autores.'}</p>
    </div>
    <div class="blocos">
      {blocos.map(({ b, tipos }) => (
        <section class="bloco reveal" aria-labelledby={`bloco-${b}`}>
          <h3 id={`bloco-${b}`} class="bloco__t"><Icon name={ICONE[b]} size={20} /> {BLOCOS[b][k]}</h3>
          <ul class="prods" role="list">
            {tipos.map((t) => {
              const d = TIPOS[t];
              const e = estado(t);
              return (
                <li class="prod">
                  <p class="prod__sigla mono">{d.sigla ? `CEE-${d.sigla}` : '—'}</p>
                  <h4><a href={href(`/publicacoes/tipo/${t}/`, lang)}>{d[k]}</a></h4>
                  <p>{d.finalidade[k]}.</p>
                  <p class="prod__cad mono">{d.extensao[k]} · {en ? 'review' : 'revisão'}: {d.revisao[k].toLowerCase()}</p>
                  <span class:list={['prod__st', { 'is-live': e.vivo }]}>{e.txt}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
    <p class="formatos__more"><a class="link-arrow" href={href('/publicacoes/', lang)}>{en ? 'All publications' : 'Todas as publicações'} <Icon name="arrow-right" size={15} /></a></p>
  </div>
</section>

<style>
  .formatos { position: relative; overflow: hidden; }
  .formatos::after { content: ''; position: absolute; right: -180px; top: -180px; width: 560px; height: 560px; border-radius: 50%; border: 90px solid rgb(255 255 255 / 3%); pointer-events: none; }
  .formatos .wrap { position: relative; z-index: 1; }
  .blocos { display: grid; gap: 40px; }
  .bloco__t { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; font: 600 12px / 1.3 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky); }
  .prods { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .prod { position: relative; border: 1px solid rgb(255 255 255 / 14%); display: flex; flex-direction: column; padding: 32px 30px 28px; background: rgb(8 28 70 / 82%); transition: background-color 0.25s; min-width: 0; }
  .prod:hover { background: rgb(22 62 120 / 92%); }
  .prod h4 { font-size: 1.125rem; line-height: 1.25; margin: 0 0 8px; }
  .prod h4 a { color: var(--white); text-decoration: none; }
  .prod h4 a::after { content: ''; position: absolute; inset: 0; }
  .prod h4 a:focus-visible { outline: 2px solid var(--sky); outline-offset: 3px; }
  .prod p { font-size: 0.90625rem; color: #b9c9d9; margin: 0 0 14px; line-height: 1.55; }
  .prod .prod__sigla { margin: 0 0 12px; color: var(--sky); font-size: 11.5px; letter-spacing: 0.06em; }
  .prod .prod__cad { color: #d6e3ef; margin-top: auto; font-size: 11.5px; }
  .prod__st { align-self: flex-start; font: 600 10.5px / 1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; border: 1px solid rgb(255 255 255 / 30%); padding: 7px 9px; color: #cfe0ef; }
  .prod__st.is-live { border-color: var(--sky); color: var(--sky); background: rgb(192 224 240 / 8%); }
  .formatos__more { margin: 36px 0 0; }
  @media (max-width: 72rem) { .prods { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .prods { grid-template-columns: minmax(0, 1fr); } .prod { padding: 26px 22px; } }
</style>
