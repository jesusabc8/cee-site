---
/**
 * "Brasil em números": dez fichas geradas de data/processed/panorama/indicadores.json.
 * Cada ficha: valor, unidade, data de referência, direção ante a observação anterior (▲▼■, sem cor
 * de juízo), minigráfico (até 10 anos), fonte, série e data de extração, e marca "calculado"
 * quando o valor é derivado pelo CEE. Sem valor → estado "dados em atualização", nunca um número.
 *
 * Vista detalhada no lugar: clicar numa ficha esconde a grade e mostra, no mesmo contêiner (mesma largura e
 * cabeçalho), o gráfico interativo da série (períodos, legenda, projeção quando houver, fontes, CSV, nota e
 * tabela), com o botão "← Voltar à tabela". Sem recarregar a página; o botão Voltar do navegador e a tecla Esc
 * também fecham, e #indicador-<id> abre direto a vista. Sem JavaScript, a grade funciona como antes.
 */
import Icon from '../ui/Icon.astro';
import ChartCard from '../charts/ChartCard.astro';
import { detalhesIndicadores, indicadores, type Indicador } from '../../lib/panorama';
import { graficosConjuntura } from '../../lib/conjuntura';
import { sparkline } from '../../lib/viz/render';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const lista = indicadores();
const detalhes = detalhesIndicadores(lang, graficosConjuntura(lang).desocupacao);

const GRUPOS = [
  { id: 'todos', pt: 'Todos', en: 'All' },
  { id: 'atividade', pt: 'Atividade', en: 'Activity' },
  { id: 'precos', pt: 'Preços e juros', en: 'Prices and rates' },
  { id: 'externo', pt: 'Externo', en: 'External' },
  { id: 'fiscal', pt: 'Fiscal', en: 'Fiscal' },
  { id: 'trabalho', pt: 'Trabalho e renda', en: 'Labour and income' },
] as const;

// Textos em inglês por indicador (o JSON do pipeline está em português).
const EN: Record<string, { titulo: string; unidade: string; descricao: string }> = {
  pib: { titulo: 'Real GDP', unidade: '% q/q', descricao: 'Change on previous quarter, seasonally adjusted' },
  ipca: { titulo: 'IPCA inflation', unidade: '% 12m', descricao: '12-month change · target 3% ± 1.5 p.p.' },
  selic: { titulo: 'Selic target', unidade: '% p.a.', descricao: 'Set by the Copom' },
  cambio: { titulo: 'Exchange rate', unidade: 'R$/US$', descricao: 'PTAX selling rate, latest quote' },
  conta_corrente: { titulo: 'Current account', unidade: '% GDP', descricao: 'Current transactions, 12-month sum' },
  primario: { titulo: 'Primary balance', unidade: '% GDP', descricao: 'Consolidated public sector, 12 months (+ surplus, − deficit)' },
  dbgg: { titulo: 'Gross debt', unidade: '% GDP', descricao: 'General government (DBGG)' },
  abertura: { titulo: 'Trade openness', unidade: '% GDP', descricao: '(Exports + imports of goods and services) ÷ GDP, current prices' },
  pobreza: { titulo: 'Poverty', unidade: '% pop.', descricao: 'Below US$6.85 a day, 2017 PPP (World Bank)' },
  desocupacao: { titulo: 'Unemployment', unidade: '%', descricao: 'PNAD Contínua, rolling quarter, not seasonally adjusted' },
};
const DIGITOS: Record<string, number> = { pib: 1, ipca: 2, selic: 2, abertura: 1, pobreza: 1, cambio: 4, conta_corrente: 2, primario: 2, dbgg: 1, desocupacao: 1 };

const nf = (v: number, d: number) => new Intl.NumberFormat(lang, { minimumFractionDigits: d, maximumFractionDigits: d }).format(Math.abs(v));
const valor = (i: Indicador) => (i.valor === null ? null : `${i.valor < 0 ? '−' : ''}${nf(i.valor, DIGITOS[i.id] ?? 2)}`);
const mesCurto = (a: number, m: number) => new Intl.DateTimeFormat(lang, { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(a, m - 1, 1))).replace('.', '');
function referencia(i: Indicador) {
  const r = i.referencia;
  if (i.tipo_ref === 'trimestre') return en ? `Q${r.slice(6)} ${r.slice(0, 4)}` : `${r.slice(6)}º tri ${r.slice(0, 4)}`;
  if (i.tipo_ref === 'ano') return String(r);
  if (i.tipo_ref === 'mes') return mesCurto(Number(r.slice(0, 4)), Number(r.slice(5, 7)));
  if (i.tipo_ref === 'trimestre-movel') {
    const a = Number(r.slice(0, 4)); const m = Number(r.slice(5, 7));
    const ini = new Date(Date.UTC(a, m - 3, 1));
    const fmt = (d: Date) => new Intl.DateTimeFormat(lang, { month: 'short', timeZone: 'UTC' }).format(d).replace('.', '');
    return `${fmt(ini)}–${fmt(new Date(Date.UTC(a, m - 1, 1)))} ${a}`;
  }
  return new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${r}T12:00:00Z`)).replace('.', '').replace(/ de /g, ' ');
}
const dirTxt: Record<string, string> = en
  ? { '▲': 'up on previous observation', '▼': 'down on previous observation', '■': 'unchanged from previous observation' }
  : { '▲': 'acima da observação anterior', '▼': 'abaixo da observação anterior', '■': 'igual à observação anterior' };
const fd = (iso: string) => new Intl.DateTimeFormat(lang, { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso));
const serieCurta = (s: string) => s.split(/[,(]/)[0]!.trim();
const sigla = (f: string) => (f === 'Banco Central do Brasil' ? 'BCB' : f === 'Groningen Growth and Development Centre' ? 'GGDC' : f.split(' — ')[0]!);
---
<section class="bn" id="brasil-em-numeros" aria-labelledby="bn-t">
  <div class="wrap">
    <div class="bn__head">
      <h2 id="bn-t">{en ? 'Brazil in numbers' : 'Brasil em números'}</h2>
      <div class="chips" role="group" aria-label={en ? 'Filter indicators' : 'Filtrar indicadores'}>
        {GRUPOS.map((g, k) => <button type="button" class="chip" data-grupo={g.id} aria-pressed={k === 0 ? 'true' : 'false'}>{en ? g.en : g.pt}</button>)}
      </div>
    </div>
    <div class="bn__panel" data-bn-panel>
    <ul class="bn__grid" role="list" data-bn-grid>
      {lista.map((i) => {
        const t = en ? EN[i.id] ?? i : i;
        const v = valor(i);
        return (
          <li class="tile" data-grupo={i.grupo}>
            <p class="tile__top"><Icon name={i.icone} size={18} /> <span>{t.titulo}</span></p>
            {v === null ? (
              <p class="tile__skel"><span></span>{en ? 'Data being updated' : 'Dados em atualização'}</p>
            ) : (
              <p class="tile__val num">{v}<small>{t.unidade}</small></p>
            )}
            <p class="tile__lab">{t.descricao.replace(/ · (calculad[oa]|calculated)$/, '')}{i.secundario != null && (en ? `; extreme poverty (US$2.15): ${nf(i.secundario, 1)}%` : `; extrema pobreza (US$ 2,15): ${nf(i.secundario, 1)}%`)}{i.calculado && <span class="tile__calc">{en ? 'calculated' : 'calculado'}</span>}</p>
            {i.spark.length > 1 && <Fragment set:html={sparkline(i.spark, 200, 34, '#4A7C96', '#0A2259')} />}
            <p class="tile__meta mono">
              <span>{referencia(i)}</span>
              {v !== null && <span class="tile__dir" title={dirTxt[i.variacao]}><span aria-hidden="true">{i.variacao}</span><span class="visually-hidden">{dirTxt[i.variacao]}</span></span>}
            </p>
            <p class="tile__src mono"><abbr title={i.fonte}>{sigla(i.fonte)}</abbr> · {serieCurta(i.serie)} · {en ? 'ext.' : 'extr.'} {fd(i.extraido_em)}{i.desatualizado && <> · <span class="tile__stale">{en ? 'previous vintage' : 'vintage anterior'}</span></>}</p>
            {detalhes[i.id] && (
              <button type="button" class="tile__open" data-bn-open={i.id} aria-controls={`bn-det-${i.id}`} aria-expanded="false">
                <span class="visually-hidden">{en ? 'Open the detailed chart' : 'Abrir o gráfico detalhado'}: {t.titulo}</span>
              </button>
            )}
          </li>
        );
      })}
    </ul>
    {lista.filter((i) => detalhes[i.id]).map((i) => {
      const t = en ? EN[i.id] ?? i : i;
      return (
        <div class="bn__detail" id={`bn-det-${i.id}`} role="region" aria-label={`${en ? 'Detailed chart' : 'Gráfico detalhado'}: ${t.titulo}`} tabindex="-1" hidden data-pagefind-ignore>
          <div class="bn__bar">
            <p class="bn__crumb"><Icon name={i.icone} size={16} /> {en ? 'Brazil in numbers' : 'Brasil em números'} <span aria-hidden="true">›</span> {t.titulo}</p>
            <button type="button" class="bn__back" data-bn-close><Icon name="arrow-left" size={15} /> {en ? 'Back to the table' : 'Voltar à tabela'}</button>
          </div>
          <ChartCard g={detalhes[i.id]!} lang={lang} nivel="h3" preRender={false} />
        </div>
      );
    })}
    </div>
    <p class="bn__note" data-bn-note>{en
      ? 'Each tile is generated from the data pipeline: official source, series code, reference date and extraction date. ▲▼■ show the direction relative to the previous observation and carry no judgement. Sparklines cover up to the last ten years.'
      : 'Cada ficha é gerada pelo pipeline de dados: fonte oficial, código da série, data de referência e data de extração. ▲▼■ indicam a direção ante a observação anterior, sem juízo de valor. Os minigráficos cobrem até os últimos dez anos.'}</p>
  </div>
</section>

<script>
  const sec = document.getElementById('brasil-em-numeros');
  const grid = sec?.querySelector<HTMLElement>('[data-bn-grid]');
  const nota = sec?.querySelector<HTMLElement>('[data-bn-note]');
  const chips = [...(sec?.querySelectorAll<HTMLButtonElement>('.chip') ?? [])];
  const tiles = [...(sec?.querySelectorAll<HTMLElement>('.tile') ?? [])];
  const abrirBtns = [...(sec?.querySelectorAll<HTMLButtonElement>('[data-bn-open]') ?? [])];
  const detalhes = [...(sec?.querySelectorAll<HTMLElement>('.bn__detail') ?? [])];
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const HASH = /^#indicador-([a-z_]+)$/;
  let aberto: string | null = null;

  const trazerAVista = () => {
    if (!sec) return;
    const topo = sec.getBoundingClientRect().top;
    if (topo < 0 || topo > window.innerHeight * 0.4) sec.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth', block: 'start' });
  };

  function abrir(id: string, { historico = true, foco = true } = {}) {
    const det = document.getElementById(`bn-det-${id}`);
    if (!sec || !grid || !det) return;
    grid.hidden = true;
    if (nota) nota.hidden = true;
    detalhes.forEach((d) => { d.hidden = d !== det; });
    abrirBtns.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.bnOpen === id)));
    sec.dataset.estado = 'detalhe';
    aberto = id;
    if (historico) history.pushState({ bn: id }, '', `#indicador-${id}`);
    trazerAVista();
    if (foco) det.focus({ preventScroll: true });
  }

  function fechar({ foco = true } = {}) {
    if (!sec || !grid || aberto === null) return;
    const id = aberto;
    aberto = null;
    detalhes.forEach((d) => { d.hidden = true; });
    grid.hidden = false;
    if (nota) nota.hidden = false;
    abrirBtns.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    delete sec.dataset.estado;
    trazerAVista();
    if (foco) abrirBtns.find((b) => b.dataset.bnOpen === id)?.focus({ preventScroll: true });
  }

  // Voltar à grade: desfaz a entrada no histórico criada ao abrir (o popstate fecha a vista).
  const voltar = () => {
    if ((history.state as { bn?: string } | null)?.bn) history.back();
    else { fechar(); if (HASH.test(location.hash)) history.replaceState(null, '', location.pathname + location.search); }
  };

  abrirBtns.forEach((b) => b.addEventListener('click', () => abrir(b.dataset.bnOpen!)));
  sec?.querySelectorAll<HTMLButtonElement>('[data-bn-close]').forEach((b) => b.addEventListener('click', voltar));
  sec?.addEventListener('keydown', (e) => { if (e.key === 'Escape' && aberto) { e.preventDefault(); voltar(); } });
  window.addEventListener('popstate', (e) => {
    const id = (e.state as { bn?: string } | null)?.bn;
    if (id) abrir(id, { historico: false });
    else fechar();
  });

  // Filtros: com a vista detalhada aberta, um filtro volta para a grade já filtrada.
  chips.forEach((c) => c.addEventListener('click', () => {
    if (aberto) voltar();
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    const g = c.dataset.grupo;
    tiles.forEach((t) => { t.hidden = g !== 'todos' && t.dataset.grupo !== g; });
  }));

  // Link interno para #indicador-<id> na mesma página (âncora clicada ou hash digitado).
  window.addEventListener('hashchange', () => {
    const h = HASH.exec(location.hash);
    if (h && document.getElementById(`bn-det-${h[1]}`) && aberto !== h[1]) {
      history.replaceState({ bn: h[1] }, '', location.href);
      abrir(h[1]!, { historico: false });
    }
  });

  // Link direto: /#indicador-ipca abre a vista detalhada.
  const m = HASH.exec(location.hash);
  if (m && document.getElementById(`bn-det-${m[1]}`)) {
    history.replaceState({ bn: m[1] }, '', location.href);
    abrir(m[1]!, { historico: false, foco: false });
  }
</script>

<style>
  .bn { position: relative; z-index: 5; margin-top: -120px; scroll-margin-top: 96px; }
  .bn__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 18px; }
  .bn__head h2 { font-size: 1.375rem; color: var(--white); letter-spacing: -0.01em; }
  .chips { display: none; gap: 8px; flex-wrap: wrap; }
  :global(.js) .chips { display: flex; }
  .chip {
    font: 600 12px / 1 var(--sans);
    letter-spacing: 0.06em;
    padding: 10px 14px;
    border-radius: 30px;
    border: 1px solid rgb(255 255 255 / 45%);
    color: var(--white);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .chip:hover { background: rgb(255 255 255 / 12%); }
  .chip[aria-pressed='true'] { background: var(--white); color: var(--navy); border-color: var(--white); }
  .chip:focus-visible { outline-color: var(--sky); }
  .bn__panel { background: var(--white); border-top: 3px solid var(--petrol); box-shadow: var(--shadow-panel); }
  .bn__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .bn__grid[hidden], .bn__detail[hidden], .bn__note[hidden] { display: none; }
  .tile__open { display: none; }
  :global(.js) .tile__open { display: block; position: static; padding: 0; border: 0; background: none; width: 0; height: 0; }
  .tile__open::after { content: ''; position: absolute; inset: 0; cursor: pointer; }
  .tile__open:focus-visible { outline: none; }
  .tile__open:focus-visible::after { outline: 2px solid var(--petrol); outline-offset: -4px; }
  :global(.js) .tile:hover .tile__val { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .bn__detail { padding: 22px 28px 24px; outline: none; animation: bn-in 0.25s ease-out; }
  @keyframes bn-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .bn__detail { animation: none; } }
  .bn__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .bn__crumb { display: inline-flex; align-items: center; gap: 8px; margin: 0; font: 600 11.5px / 1.3 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--petrol); }
  .bn__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 12px / 1 var(--sans);
    letter-spacing: 0.06em;
    padding: 10px 16px;
    border-radius: 30px;
    border: 1px solid var(--navy);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .bn__back:hover { background: var(--navy); color: var(--white); }
  .bn__back:focus-visible { outline: 2px solid var(--petrol); outline-offset: 3px; }
  /* Fora da grade do Panorama a ficha não é subgrid: fluxo em bloco, para os controles terem altura própria. */
  .bn__detail :global(.chart-card) { display: block; border: 0; padding: 18px 0 0; background: transparent; }
  .bn__detail :global(.chart-card__foot) { margin-top: 6px; }
  .bn__detail :global(.chart-card__title) { font-size: 1.5rem; }
  .bn__detail :global(.chart-card__sub) { font-size: 1rem; }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 228px;
    padding: 22px 22px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.2s;
  }
  .tile:nth-child(5n) { border-right: 0; }
  .tile:hover { background: var(--mist); }
  .tile[hidden] { display: none; }
  .tile__top { display: flex; align-items: center; gap: 9px; margin: 0; color: var(--petrol); font: 600 11.5px / 1.2 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; }
  .tile__calc { display: inline-block; margin-left: 6px; vertical-align: 1px; font: 500 9.5px / 1 var(--mono); letter-spacing: 0.06em; color: var(--navy); border: 1px solid var(--line-strong); padding: 3px 5px; }
  .tile__val { margin: 14px 0 2px; font: 600 2.125rem / 1.1 var(--sans); letter-spacing: -0.02em; color: var(--navy); white-space: nowrap; }
  .tile__val small { font-size: 0.9375rem; font-weight: 500; letter-spacing: 0; color: var(--muted); margin-left: 4px; }
  .tile__skel { margin: 14px 0 2px; font-size: 13px; color: var(--muted); }
  .tile__skel span { display: block; width: 60%; height: 30px; margin-bottom: 6px; background: linear-gradient(90deg, var(--paper), var(--mist), var(--paper)); }
  .tile__lab { margin: 0; font-size: 13px; line-height: 1.38; color: var(--muted); min-height: 2.8em; }
  .tile :global(svg.spark) { display: block; width: 100%; height: 34px; margin-top: 10px; }
  .tile__meta { display: flex; justify-content: space-between; gap: 8px; margin: auto 0 0; padding-top: 10px; font-size: 11px; color: var(--ink); }
  .tile__dir { color: var(--navy); }
  .tile__src abbr { text-decoration: none; }
  .tile__src { margin: 4px 0 0; font-size: 10.5px; line-height: 1.35; color: var(--muted); overflow-wrap: anywhere; }
  .tile__stale { color: var(--navy); text-decoration: underline dotted; }
  .bn__note { margin: 14px 0 0; font-size: 12.5px; color: var(--muted); max-width: 90ch; }
  @media (max-width: 75rem) {
    .bn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tile:nth-child(5n) { border-right: 1px solid var(--line); }
    .tile:nth-child(3n) { border-right: 0; }
  }
  @media (max-width: 48rem) {
    .bn__detail { padding: 16px 16px 18px; }
    .bn__detail :global(.chart-card__title) { font-size: 1.25rem; }
    .bn__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile:nth-child(3n) { border-right: 1px solid var(--line); }
    .tile:nth-child(2n) { border-right: 0; }
    .tile { padding: 18px 16px 14px; min-height: 0; }
    .tile__val { font-size: 1.75rem; }
  }
  @media (max-width: 30rem) {
    .tile { padding: 16px 12px 12px; }
    .tile__top { font-size: 10px; letter-spacing: 0.06em; align-items: flex-start; }
    .tile__val { font-size: 1.5rem; white-space: normal; }
    .tile__val small { display: block; margin: 2px 0 0; font-size: 0.8125rem; }
    .tile__lab { font-size: 12px; }
    .tile__src { font-size: 9.5px; }
  }
  @media (max-width: 21rem) {
    .bn__grid { grid-template-columns: minmax(0, 1fr); }
    .tile { border-right: 0 !important; }
  }
</style>
