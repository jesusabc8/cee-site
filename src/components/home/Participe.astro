---
/**
 * Convite a participar (Estatuto, arts. 11 e 19; Regimento Interno, arts. 3º a 8º): convocatória aberta,
 * carreira em cinco níveis, trilha formativa.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const FATOS = en
  ? [
    ['door-open', 'Open entry', 'Calls in February and August, with no test, no grade requirement and no prior programming or econometrics. If places run out, a public draw decides.'],
    ['award', 'Five-level research career', 'From Participant (N1) to Senior Researcher (N5), with public cumulative criteria based on published outputs, verifications and reviews. Merit counts for progressing and for office, never for joining.'],
    ['graduation-cap', 'Training track', 'In the first semester: research integrity, Brazilian data sources, R or Python and version control, technical writing and visualisation, reproducibility and peer review.'],
  ]
  : [
    ['door-open', 'Ingresso aberto', 'Convocatórias em fevereiro e agosto, sem prova, sem exigência de nota e sem conhecimento prévio de programação ou econometria. Se faltarem vagas, decide o sorteio público.'],
    ['award', 'Carreira em cinco níveis', 'De Participante (N1) a Pesquisador(a) Sênior (N5), com critérios públicos e cumulativos baseados em produtos publicados, verificações e revisões. O mérito vale para progredir e para os cargos, nunca para entrar.'],
    ['graduation-cap', 'Trilha formativa', 'No primeiro semestre: integridade acadêmica, fontes de dados brasileiras, R ou Python e controle de versões, redação técnica e visualização, reprodutibilidade e revisão por pares.'],
  ];
---
<section class="participe band-petrol" id="participe" aria-labelledby="part-t">
  <div class="wrap participe__grid">
    <div class="reveal">
      <p class="eyebrow">{en ? 'Get involved' : 'Participe'}</p>
      <h2 id="part-t">{en ? 'Learn economic research by doing economic research.' : 'Aprenda a fazer pesquisa econômica fazendo pesquisa econômica.'}</h2>
      <p class="participe__lead">{en
        ? 'Open to students of Economics and of other programmes whose contribution is relevant. Responsibility grows with proven output, according to written, public criteria.'
        : 'Aberto a estudantes de Ciências Econômicas e de outros cursos cuja contribuição seja pertinente. A responsabilidade cresce com a produção comprovada, segundo critérios escritos e públicos.'}</p>
      <a class="btn btn--sky" href={href('/participe/', lang)}>{en ? 'How to get involved' : 'Como participar'} <Icon name="arrow-right" size={16} /></a>
    </div>
    <ul class="facts reveal" role="list">
      {FATOS.map(([ic, t, d]) => (
        <li class="fact"><span class="fact__icon"><Icon name={ic!} size={26} /></span><span><b>{t}</b><span>{d}</span></span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .participe { padding-block: clamp(72px, 7vw, 100px); }
  .participe__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .participe h2 { font-size: clamp(1.875rem, 1.3rem + 2vw, 2.875rem); line-height: 1.1; margin: 14px 0 18px; max-width: 18ch; }
  .participe__lead { color: #cfdce8; font-size: 1.0625rem; line-height: 1.6; max-width: 52ch; margin: 0 0 28px; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .fact { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border: 1px solid rgb(255 255 255 / 22%); background: rgb(255 255 255 / 5%); }
  .fact__icon { color: var(--sky); flex: none; margin-top: 2px; }
  .fact b { display: block; font-size: 0.96875rem; line-height: 1.3; color: var(--white); }
  .fact span span { display: block; margin-top: 4px; font-size: 0.875rem; line-height: 1.5; color: #c4d4e3; }
  @media (max-width: 64rem) { .participe__grid { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
</style>
