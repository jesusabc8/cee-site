---
/**
 * Fluxo editorial (Regimento Interno, art. 46; Manual, Parte II), agrupado em seis etapas, como abas verticais
 * acessíveis: setas ↑↓ (e ←→), Home/End; sem JavaScript, as etapas aparecem em sequência.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
// [título, resumo, texto, regra/saída]
const PT: [string, string, string, string][] = [
  ['Registro da proposta', 'Pergunta, fontes, período e método, antes de começar.', 'Todo produto começa com o registro da proposta junto ao Coordenador de Programa: pergunta específica, programa e pergunta do Manual a que responde, fontes, período, método, cronograma e verificador proposto.', 'Saída: proposta aprovada, aprovada com ajustes ou não aprovada pelo Coordenador.'],
  ['Dados e código', 'Tudo reexecutável a partir dos dados de origem.', 'A elaboração é feita com dados e código no repositório do CEE, com histórico de versões. Os dados brutos não são editados à mão; tudo o que é derivado vem de código.', 'Regra: todo número publicado deve ser reexecutável a partir dos dados de origem.'],
  ['Verificação numérica', 'Outra pessoa reexecuta e confere cada número.', 'Uma pessoa distinta dos autores reexecuta o código e confere cada número, tabela e gráfico, com relatório de conferência no repositório.', 'Regra: nenhum autor revisa o próprio trabalho.'],
  ['Revisão e pareceres', 'Revisão editorial; parecer docente e externo quando exigidos.', 'Conforme o produto, a revisão mínima inclui revisão editorial, parecer docente de conteúdo e, no Texto para Discussão, parecer externo.', 'Nota Técnica: numérica, editorial e docente. Texto para Discussão: também parecer externo.'],
  ['Comitê Editorial', 'Órgão independente que aprova todas as publicações.', 'A submissão vai ao Comitê Editorial com todos os registros de revisão e a lista de verificação do Manual. O Comitê aprova, aprova com ajustes menores, devolve para revisão ou rejeita, com fundamentação.', 'Regra: a Diretoria não pode revogar decisão editorial nem dispensar revisão.'],
  ['Publicação e errata', 'Versão, autoria CRediT, licença e aviso.', 'O produto sai com identificador e versão, autoria por função (CRediT), fontes, licença CC BY 4.0, declaração de uso de IA e aviso de responsabilidade. Erro material gera aviso e errata públicos.', 'Regra: aviso vinculado ao produto em até sete dias corridos da ciência do erro.'],
];
const EN: [string, string, string, string][] = [
  ['Proposal registration', 'Question, sources, period and method, before starting.', 'Every output starts with a proposal registered with the Programme Coordinator: specific question, the programme and Manual question it answers, sources, period, method, timetable and proposed verifier.', 'Output: proposal approved, approved with changes or not approved by the Coordinator.'],
  ['Data and code', 'Everything re-runnable from the source data.', 'Work is done with data and code in a CEE repository, with version history. Raw data are never edited by hand; everything derived comes from code.', 'Rule: every published number must be re-runnable from the source data.'],
  ['Numerical verification', 'Someone else re-runs and checks every number.', 'A person other than the authors re-runs the code and checks every number, table and chart, with a verification report in the repository.', 'Rule: no author reviews their own work.'],
  ['Review and reports', 'Editorial review; faculty and external reports where required.', 'Depending on the output, the minimum review includes editorial review, a faculty content report and, for Discussion Papers, an external report.', 'Technical Note: numerical, editorial and faculty. Discussion Paper: also an external report.'],
  ['Editorial Committee', 'Independent body that approves every publication.', 'The submission goes to the Editorial Committee with all review records and the Manual checklist. The Committee approves, approves with minor changes, returns for revision or rejects, with reasons.', 'Rule: the Board cannot overturn an editorial decision or waive review.'],
  ['Publication and errata', 'Version, CRediT authorship, licence and disclaimer.', 'The output is released with identifier and version, authorship by role (CRediT), sources, a CC BY 4.0 licence, an AI-use statement and a disclaimer. A material error triggers a public notice and erratum.', 'Rule: a notice linked to the output within seven calendar days of becoming aware of the error.'],
];
const ST = en ? EN : PT;
const ICONES = ['clipboard-list', 'folder-git-2', 'git-compare-arrows', 'list-checks', 'scale', 'badge-check'];
const INI = 2;
const dd = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="metodo band-paper section" id="metodo" aria-labelledby="metodo-t">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">{en ? 'Methodology and reproducibility' : 'Metodologia e reprodutibilidade'}</p>
        <h2 id="metodo-t">{en ? 'No number goes out without independent verification' : 'Nenhum número sai sem verificação independente'}</h2>
      </div>
      <a class="link-arrow" href={href('/metodologia/', lang)}>{en ? 'Read the full protocol' : 'Ler o protocolo completo'} <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="stepper reveal" data-stepper>
      <div class="steps" role="tablist" aria-orientation="vertical" aria-label={en ? 'Stages of the method' : 'Etapas do método'}>
        {ST.map((s, i) => (
          <button type="button" class="step" role="tab" id={`step-${i}`} aria-controls={`step-p-${i}`} aria-selected={i === INI ? 'true' : 'false'} tabindex={i === INI ? 0 : -1}>
            <span class="step__n">{dd(i)}</span>
            <span class="step__txt"><b>{s[0]}</b><span>{s[1]}</span></span>
          </button>
        ))}
      </div>
      <div class="panels">
        {ST.map((s, i) => (
          <div class="panel" role="tabpanel" id={`step-p-${i}`} aria-labelledby={`step-${i}`} data-ini={i === INI ? '' : undefined}>
            <p class="eyebrow">{en ? 'Stage' : 'Etapa'} {dd(i)} {en ? 'of' : 'de'} {dd(ST.length - 1)}</p>
            <h3>{s[0]}</h3>
            <p>{s[2]}</p>
            <p class="panel__rule mono">{s[3]}</p>
            <span class="panel__big" aria-hidden="true"><Icon name={ICONES[i]!} size={220} /></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const ativar = (i: number, foco = false) => {
      tabs.forEach((t, k) => { const on = k === i; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (foco) tabs[i]!.focus();
    };
    root.classList.add('is-on');
    ativar(Math.max(0, panels.findIndex((p) => p.hasAttribute('data-ini'))));
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => ativar(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const alvo = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: n - 1 }[e.key];
        if (alvo === undefined) return;
        e.preventDefault();
        ativar((alvo + n) % n, true);
      });
    });
  });
</script>

<style>
  .stepper { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
  /* Sem JS: lista de abas oculta e as seis etapas em sequência */
  .steps { display: none; flex-direction: column; }
  .stepper:not(.is-on) { grid-template-columns: minmax(0, 1fr); }
  .stepper:not(.is-on) .panels { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 16px; }
  .stepper.is-on .steps { display: flex; }
  .step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    width: 100%;
    padding: 18px 22px;
    border: 0;
    border-left: 3px solid var(--line);
    background: transparent;
    text-align: left;
    font-family: var(--sans);
    cursor: pointer;
    transition: background-color 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .step:hover { background: var(--white); }
  .step[aria-selected='true'] { background: var(--white); border-left-color: var(--petrol); box-shadow: 0 14px 34px -24px rgb(11 37 69 / 50%); }
  .step__n { font: 600 13px / 1.6 var(--mono); color: var(--petrol); min-width: 26px; }
  .step__txt b { display: block; font: 600 1.0625rem / 1.3 var(--sans); color: var(--navy); }
  .step__txt span { display: none; margin-top: 6px; font-size: 0.875rem; color: var(--muted); line-height: 1.45; }
  .step[aria-selected='true'] .step__txt span { display: block; }
  .panel {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    padding: 40px;
    color: var(--white);
    background: linear-gradient(160deg, var(--navy), #123a6e);
  }
  .stepper:not(.is-on) .panel { min-height: 0; padding: 28px; }
  .panel[hidden] { display: none; }
  .panel .eyebrow { color: var(--sky); }
  .panel h3 { color: var(--white); font-size: 1.625rem; margin: 12px 0 16px; }
  .panel p { color: #c9d7e4; font-size: 1rem; line-height: 1.6; margin: 0 0 20px; max-width: 48ch; position: relative; }
  .panel .panel__rule { border: 1px solid rgb(255 255 255 / 22%); padding: 16px 18px; color: #e8f0f7; font-size: 12.5px; line-height: 1.6; }
  .panel__big { position: absolute; right: -30px; bottom: -40px; color: rgb(255 255 255 / 5%); }
  .panel__big :global(svg) { stroke-width: 1; }
  @media (max-width: 64rem) {
    .stepper { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .panel { min-height: 0; padding: 28px 22px; }
  }
</style>
