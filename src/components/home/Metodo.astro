---
/**
 * Metodologia em seis etapas (Proposta §6.1–6.6 e Anexo E), como abas verticais acessíveis:
 * setas ↑↓ (e ←→), Home/End; sem JavaScript, as seis etapas aparecem em sequência.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
// [título, resumo, texto, regra/saída]
const PT: [string, string, string, string][] = [
  ['Pergunta', 'Uma pergunta respondível com dado público.', 'Toda análise começa por uma pergunta escrita, delimitada e respondível com dado público disponível.', 'Saída: pergunta registrada na ficha de desenho analítico.'],
  ['Ficha de desenho', 'Método definido antes de ver o resultado.', 'Antes do exame de qualquer resultado, o autor preenche, em uma página, a ficha de desenho analítico: pergunta, hipótese, fontes, especificação principal, testes de robustez previstos e o que contaria como evidência contrária.', 'Saída: ficha datada e arquivada no repositório.'],
  ['Dado e código', 'Dados brutos imutáveis; tudo derivado vem de script.', 'Os dados brutos nunca são editados à mão. Todo produto é um repositório com a mesma estrutura, de modo que qualquer integrante reexecute o trabalho de outro sem instruções adicionais.', 'Saída: repositório com estrutura fixa e dados brutos imutáveis.'],
  ['Verificação independente', 'Outra pessoa reexecuta e confere cada número.', 'Um integrante que não é autor reexecuta o repositório do zero, em máquina distinta, e confere cada tabela e figura do texto.', 'Regra: nenhum número é publicado sem que outra pessoa reexecute o código e chegue ao mesmo resultado.'],
  ['Revisão de conteúdo e editorial', 'Docente de referência e Comitê Editorial.', 'Conforme o produto, um docente de referência avalia a adequação do método e as limitações declaradas, e o Comitê Editorial confere clareza, citação, unidades, rótulos e licença.', 'Nota Técnica: três camadas. Working paper: três camadas e parecer externo ao Centro.'],
  ['Publicação e errata', 'Licença aberta; correção pública e datada.', 'O produto sai com licença aberta, autoria por função (CRediT) e declaração de uso de IA. Erros identificados viram errata pública e datada.', 'Regra: correção silenciosa é falta grave; a errata sai em menos de sete dias após a identificação do erro.'],
];
const EN: [string, string, string, string][] = [
  ['Question', 'A question answerable with public data.', 'Every analysis starts from a written, bounded question that can be answered with available public data.', 'Output: question recorded in the analytical design form.'],
  ['Design form', 'Method set before seeing the result.', 'Before looking at any result, the author fills in a one-page analytical design form: question, hypothesis, sources, main specification, planned robustness checks and what would count as contrary evidence.', 'Output: dated form filed in the repository.'],
  ['Data and code', 'Immutable raw data; everything derived comes from scripts.', 'Raw data are never edited by hand. Every output is a repository with the same structure, so that any member can re-run another\'s work without further instructions.', 'Output: repository with a fixed structure and immutable raw data.'],
  ['Independent verification', 'Someone else re-runs and checks every number.', 'A member who is not an author re-runs the repository from scratch, on a different machine, and checks every table and figure in the text.', 'Rule: no number is published unless someone else re-runs the code and obtains the same result.'],
  ['Content and editorial review', 'Reference faculty member and Editorial Committee.', 'Depending on the output, a reference faculty member assesses the method and stated limitations, and the Editorial Committee checks clarity, citation, units, labels and licence.', 'Technical Note: three layers. Working paper: three layers plus external review.'],
  ['Publication and errata', 'Open licence; public, dated corrections.', 'The output is released under an open licence, with authorship by role (CRediT) and an AI-use statement. Errors become public, dated errata.', 'Rule: silent correction is a serious breach; the erratum is published within seven days of the error being identified.'],
];
const ST = en ? EN : PT;
const ICONES = ['search', 'pencil-ruler', 'folder-git-2', 'git-compare-arrows', 'list-checks', 'badge-check'];
const INI = 3;
const dd = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="metodo band-paper section" id="metodo" aria-labelledby="metodo-t">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">{en ? 'Methodology and reproducibility' : 'Metodologia e reprodutibilidade'}</p>
        <h2 id="metodo-t">{en ? 'No number goes out without independent verification' : 'Nenhum número sai sem verificação independente'}</h2>
      </div>
      <a class="link-arrow" href={href('/metodologia/', lang)}>{en ? 'Read the full protocol' : 'Ler o protocolo completo'} <Icon name="arrow-right" size={15} /></a>
    </div>
    <div class="stepper reveal" data-stepper>
      <div class="steps" role="tablist" aria-orientation="vertical" aria-label={en ? 'Stages of the method' : 'Etapas do método'}>
        {ST.map((s, i) => (
          <button type="button" class="step" role="tab" id={`step-${i}`} aria-controls={`step-p-${i}`} aria-selected={i === INI ? 'true' : 'false'} tabindex={i === INI ? 0 : -1}>
            <span class="step__n">{dd(i)}</span>
            <span class="step__txt"><b>{s[0]}</b><span>{s[1]}</span></span>
          </button>
        ))}
      </div>
      <div class="panels">
        {ST.map((s, i) => (
          <div class="panel" role="tabpanel" id={`step-p-${i}`} aria-labelledby={`step-${i}`} data-ini={i === INI ? '' : undefined}>
            <p class="eyebrow">{en ? 'Stage' : 'Etapa'} {dd(i)} {en ? 'of' : 'de'} 06</p>
            <h3>{s[0]}</h3>
            <p>{s[2]}</p>
            <p class="panel__rule mono">{s[3]}</p>
            <span class="panel__big" aria-hidden="true"><Icon name={ICONES[i]!} size={220} /></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const ativar = (i: number, foco = false) => {
      tabs.forEach((t, k) => { const on = k === i; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (foco) tabs[i]!.focus();
    };
    root.classList.add('is-on');
    ativar(Math.max(0, panels.findIndex((p) => p.hasAttribute('data-ini'))));
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => ativar(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const alvo = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: n - 1 }[e.key];
        if (alvo === undefined) return;
        e.preventDefault();
        ativar((alvo + n) % n, true);
      });
    });
  });
</script>

<style>
  .stepper { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; align-items: start; }
  /* Sem JS: lista de abas oculta e as seis etapas em sequência */
  .steps { display: none; flex-direction: column; }
  .stepper:not(.is-on) { grid-template-columns: minmax(0, 1fr); }
  .stepper:not(.is-on) .panels { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 16px; }
  .stepper.is-on .steps { display: flex; }
  .step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    width: 100%;
    padding: 18px 22px;
    border: 0;
    border-left: 3px solid var(--line);
    background: transparent;
    text-align: left;
    font-family: var(--sans);
    cursor: pointer;
    transition: background-color 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .step:hover { background: var(--white); }
  .step[aria-selected='true'] { background: var(--white); border-left-color: var(--petrol); box-shadow: 0 14px 34px -24px rgb(11 37 69 / 50%); }
  .step__n { font: 600 13px / 1.6 var(--mono); color: var(--petrol); min-width: 26px; }
  .step__txt b { display: block; font: 600 1.0625rem / 1.3 var(--sans); color: var(--navy); }
  .step__txt span { display: none; margin-top: 6px; font-size: 0.875rem; color: var(--muted); line-height: 1.45; }
  .step[aria-selected='true'] .step__txt span { display: block; }
  .panel {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    padding: 40px;
    color: var(--white);
    background: linear-gradient(160deg, var(--navy), #123a6e);
  }
  .stepper:not(.is-on) .panel { min-height: 0; padding: 28px; }
  .panel[hidden] { display: none; }
  .panel .eyebrow { color: var(--sky); }
  .panel h3 { color: var(--white); font-size: 1.625rem; margin: 12px 0 16px; }
  .panel p { color: #c9d7e4; font-size: 1rem; line-height: 1.6; margin: 0 0 20px; max-width: 48ch; position: relative; }
  .panel .panel__rule { border: 1px solid rgb(255 255 255 / 22%); padding: 16px 18px; color: #e8f0f7; font-size: 12.5px; line-height: 1.6; }
  .panel__big { position: absolute; right: -30px; bottom: -40px; color: rgb(255 255 255 / 5%); }
  .panel__big :global(svg) { stroke-width: 1; }
  @media (max-width: 64rem) {
    .stepper { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .panel { min-height: 0; padding: 28px 22px; }
  }
</style>
