---
/**
 * Pesquisa (portada): os seis programas do Manual (Parte I) com objeto, situação e painéis, e um bloco para o
 * Programa Transversal e as lentes. Conteúdo de src/data/programas.yaml e linhas.yaml; rótulos derivados dos dados.
 */
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import StatusTag from '../StatusTag.astro';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const k = en ? 'en' : 'pt';
const todos = (await getCollection('programas')).sort((a, b) => a.data.ordem - b.data.ordem);
const programas = todos.filter((p) => p.data.tipo === 'programa');
const transversal = todos.find((p) => p.data.tipo === 'transversal');
const lentes = todos.filter((p) => p.data.tipo === 'lente');
const linhas = (await getCollection('linhas')).sort((a, b) => a.data.codigo.localeCompare(b.data.codigo));
const ICONE: Record<string, string> = { a: 'trending-up', b: 'chart-column-increasing', c: 'users', d: 'globe', e: 'landmark', f: 'leaf' };
const EXT = { pt: ['zero', 'um', 'dois', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito'], en: ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight'] };
const nProg = EXT[k][programas.length] ?? String(programas.length);
---
<section class="areas-sec band-slate section" id="pesquisa" aria-labelledby="areas-t">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <p class="eyebrow">{en ? 'Research' : 'Pesquisa'}</p>
        <h2 id="areas-t">{en ? `${nProg[0]!.toUpperCase()}${nProg.slice(1)} research programmes` : `${nProg[0]!.toUpperCase()}${nProg.slice(1)} programas de pesquisa`}</h2>
      </div>
      <p>{en
        ? "Permanent lines of research, each with its scope, boundaries and questions. The Observatory is one of CEE's outputs; its panels follow the programmes."
        : 'Linhas permanentes de pesquisa, cada uma com objeto, fronteiras e perguntas. O Observatório é um dos produtos do CEE; seus painéis seguem os programas.'}</p>
    </div>
    <div class="areas">
      {programas.map((a) => {
        const ls = linhas.filter((l) => l.data.area === a.id);
        return (
          <article class="area reveal">
            <span class="area__letter" aria-hidden="true">{a.data.codigo}</span>
            <span class="area__icon"><Icon name={ICONE[a.id] ?? 'circle'} size={24} /></span>
            <p class="area__st">{a.data.situacao && <StatusTag estado={a.data.situacao} lang={lang} />}</p>
            <h3><span class="visually-hidden">{en ? 'Programme' : 'Programa'} {a.data.codigo}: </span>{a.data.nome[k]}</h3>
            <p class="area__q">{a.data.objeto[k]}</p>
            {ls.length > 0 && (
              <ul class="area__linhas" aria-label={en ? 'Observatory panels' : 'Painéis do Observatório'}>
                {ls.map((l) => <li><b>{l.data.codigo}</b><span>{l.data.nome[k]}</span></li>)}
              </ul>
            )}
            <a class="area__go" href={href(`/pesquisa/${a.id}/`, lang)}>{en ? 'See the programme' : 'Ver o programa'}<span class="visually-hidden"> {a.data.nome[k]}</span> <Icon name="arrow-right" size={15} /></a>
          </article>
        );
      })}
    </div>
    <div class="lens reveal">
      <span class="lens__icon"><Icon name="layers" size={22} /></span>
      <p>
        {transversal && <><b>{transversal.data.nome[k]}.</b> {en ? 'Common data and code infrastructure for all programmes.' : 'Infraestrutura comum de dados e código para todos os programas.'}{' '}<a href={href(`/pesquisa/${transversal.id}/`, lang)}>{en ? 'See the programme' : 'Ver o programa'}</a><br /></>}
        <b>{en ? 'Lenses' : 'Lentes'}:</b> {lentes.map((l) => l.data.nome[k]).join('; ')} — {en ? 'perspectives applied to every programme.' : 'recortes aplicados a todos os programas.'}
      </p>
    </div>
  </div>
</section>

<style>
  .areas-sec .sec-head h2 { color: var(--navy); }
  .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .area__st { margin: 0 0 10px; }
  .area {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 38px 34px 32px;
    background: #eef4f9;
    border: 1px solid rgb(10 34 89 / 12%);
    overflow: hidden;
    transition: background-color 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .area::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--navy); }
  .area:nth-child(3n+2)::before { background: var(--petrol); }
  .area:nth-child(3n)::before { background: var(--steel); }
  .area:hover { background: var(--white); transform: translateY(-4px); box-shadow: var(--shadow-card); }
  .area__letter { position: absolute; right: 22px; top: 22px; font: 600 120px / 0.8 var(--sans); letter-spacing: -0.05em; color: rgb(11 37 69 / 7%); user-select: none; }
  .area__icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 26px; background: var(--navy); color: var(--white); border-radius: var(--radius); }
  .area:nth-child(3n+2) .area__icon { background: var(--petrol); }
  .area:nth-child(3n) .area__icon { background: var(--steel); }
  .area h3 { font-size: 1.4375rem; line-height: 1.2; margin-bottom: 12px; }
  .area__q { font: italic 400 1.0625rem / 1.55 var(--serif); color: #2e3b4b; margin: 0 0 22px; }
  .area__linhas { list-style: none; margin: 0 0 auto; padding: 0; border-top: 1px solid var(--line); }
  .area__linhas li { display: grid; grid-template-columns: 2rem 1fr; gap: 4px 10px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.90625rem; line-height: 1.4; }
  .area__linhas b { font: 600 12px / 1.6 var(--mono); color: var(--petrol); grid-row: span 2; }
  .area__linhas :global(.status) { justify-self: start; }
  .area__go { margin-top: 24px; display: inline-flex; align-items: center; gap: 10px; font: 600 0.78rem / 1 var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); text-decoration: none; transition: gap 0.2s var(--ease); }
  .area__go:hover { gap: 14px; color: var(--navy); }
  .area__go::after { content: ''; position: absolute; inset: 0; }
  .area__go:focus-visible { outline: 2px solid var(--petrol); outline-offset: 4px; }
  .lens { display: flex; gap: 18px; align-items: flex-start; margin-top: 24px; padding: 22px 26px; background: var(--navy); color: #d6e2ee; }
  .lens__icon { color: var(--sky); flex: none; margin-top: 2px; }
  .lens p { margin: 0; font-size: 0.96875rem; line-height: 1.6; }
  .lens b { color: var(--white); font-weight: 600; }
  .lens a { color: var(--sky); position: relative; z-index: 1; }
  .lens a:focus-visible { outline-color: var(--sky); }
  @media (max-width: 64rem) { .areas { grid-template-columns: minmax(0, 1fr); } .area { padding: 30px 24px 26px; } }
</style>
