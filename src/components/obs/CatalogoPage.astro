---
/** Catálogo de dados e fontes: gerado de scripts/data/series.ts + vintage (fonte única com data/CATALOGO.md). */
import Base from '../../layouts/Base.astro';
import PageHero from '../layout/PageHero.astro';
import { SERIES } from '../../../scripts/data/series.ts';
import { lerVintage } from '../../lib/dados';
import { fmtDate } from '../../lib/publicacoes';
import { href } from '../../i18n/routing';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const k = lang === 'en' ? 'en' : 'pt';
const vint = { ...lerVintage('conjuntura'), ...lerVintage('panorama') };
const L = {
  pt: { t: 'Catálogo de dados e fontes', lede: 'Séries mantidas pelo Observatório, com a verificação de cada código contra a fonte oficial. Séries não verificadas não são publicadas.',
    cod: 'Código', un: 'Unidade', freq: 'Frequência', painel: 'Painel', licenca: 'Termos de uso da fonte', verif: 'Verificação', metodo: 'Método', nome: 'Nome oficial', obs: 'Observações', ultima: 'Última extração', cobertura: 'Cobertura', csv: 'CSV', consulta: 'Consulta pública' },
  en: { t: 'Data and source catalogue', lede: 'Series maintained by the Observatory, with the verification of each code against the official source. Unverified series are not published.',
    cod: 'Code', un: 'Unit', freq: 'Frequency', painel: 'Dashboard', licenca: 'Source terms of use', verif: 'Verification', metodo: 'Method', nome: 'Official name', obs: 'Notes', ultima: 'Last extraction', cobertura: 'Coverage', csv: 'CSV', consulta: 'Public query page' },
}[k];
---
<Base title={L.t} description={L.lede} lang={lang}>
  <PageHero lang={lang} eyebrow={k === 'en' ? 'Data Observatory' : 'Observatório de Dados'} title={L.t} lede={L.lede} />
  <div class="wrap">
    <section class="section">
      <div class="table-scroll" role="region" tabindex="0" aria-label={k === 'en' ? 'Summary of series' : 'Resumo das séries'}>
        <table class="resumo">
          <caption class="visually-hidden">{k === 'en' ? 'Series, source, code, dashboard and last extraction' : 'Séries, fonte, código, painel e última extração'}</caption>
          <thead><tr><th scope="col">{k === 'en' ? 'Series' : 'Série'}</th><th scope="col">{k === 'en' ? 'Source' : 'Fonte'}</th><th scope="col">{L.cod}</th><th scope="col">{L.painel}</th><th scope="col">{L.ultima}</th></tr></thead>
          <tbody>
            {SERIES.map((s) => (
              <tr><th scope="row"><a href={`#${s.id}`}>{s.nome}</a></th><td>{s.instituicao}</td><td><code>{s.codigo}</code></td><td>{s.painel}</td><td>{vint[s.id] ? fmtDate(new Date(vint[s.id]!.extraido_em), lang, 'short') : '—'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    {SERIES.map((s) => {
      const v = vint[s.id];
      return (
        <section class="section split" id={s.id}>
          <div>
            <h2 class="section__title">{s.nome}</h2>
            <p class="meta">{s.instituicao}</p>
          </div>
          <dl class="cat">
            <dt>{L.cod}</dt><dd><code>{s.codigo}</code></dd>
            <dt>{L.un}</dt><dd>{s.unidade}</dd>
            <dt>{L.freq}</dt><dd>{s.frequencia}</dd>
            <dt>{L.painel}</dt><dd><a href={href(`/observatorio/${s.painel}/`, lang)}>{s.painel}</a></dd>
            {v && <><dt>{L.ultima}</dt><dd>{fmtDate(new Date(v.extraido_em), lang)}{v.desatualizado && ' ⚠'}</dd><dt>{L.cobertura}</dt><dd>{v.primeiro} → {v.ultimo} ({v.linhas})</dd></>}
            <dt>{L.csv}</dt><dd><a href={href(`/dados/${s.painel}/${s.id}.csv`)}>{s.id}.csv</a> · <a href={s.url_publica}>{L.consulta}</a></dd>
            <dt>{L.licenca}</dt><dd>{s.licenca_fonte}</dd>
            <dt>{L.verif}</dt><dd>{s.verificacao.data}</dd>
            <dt>{L.metodo}</dt><dd>{s.verificacao.metodo}</dd>
            <dt>{L.nome}</dt><dd>{s.verificacao.nome_oficial}</dd>
            {s.verificacao.observacoes && <><dt>{L.obs}</dt><dd>{s.verificacao.observacoes}</dd></>}
          </dl>
        </section>
      );
    })}
  </div>
</Base>
<style>
  .cat { display: grid; gap: var(--s-1) var(--s-4); margin: 0; font-size: var(--step--1); }
  @media (min-width: 40rem) { .cat { grid-template-columns: 11rem 1fr; } }
  .cat dt { font-weight: 600; }
  .cat dd { margin: 0 0 var(--s-2); color: var(--muted); }
  .resumo { width: 100%; border-collapse: collapse; font-size: 0.875rem; border-top: 2px solid var(--navy); }
  .resumo th, .resumo td { text-align: left; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .resumo thead th { font: 600 11px / 1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy); }
  .resumo tbody th { font-weight: 500; }
  .resumo code { font-family: var(--mono); font-size: 0.8125rem; overflow-wrap: anywhere; }
  .cat code { font-family: var(--mono); font-size: 0.95em; color: var(--ink); }
</style>
