---
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/print.css';
import { config } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';
import { switchHref } from '../i18n/routing';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBanner from '../components/PreviewBanner.astro';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
  /** false quando a página não tem versão na outra língua. */
  hasTranslation?: boolean;
  /** Caminho da imagem Open Graph (gerada em /og/<slug>.png). */
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const { title, description = '', lang = 'pt-BR', noindex = false, hasTranslation = true, ogImage = '/og/default.png', ogType = 'website' } = Astro.props;
const t = useTranslations(lang);
const robots = !config.lancado || noindex ? 'noindex, nofollow' : 'index, follow';
const isHome = title === t('site.name');
const fullTitle = isHome ? `${config.sigla} · ${t('site.name')}` : `${title} · ${config.sigla}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alt = hasTranslation
  ? (['pt-BR', 'en'] as const).map((l) => ({ l, href: new URL(switchHref(Astro.url, l), Astro.site).href }))
  : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alt.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content={`${config.sigla} · ${t('site.name')}`} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pt_BR'} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}${ogImage}`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${config.sigla} · ${lang === 'en' ? 'Publications' : 'Publicações'}`} href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Organization', name: `${t('site.name')} (${config.sigla})`,
      url: new URL(import.meta.env.BASE_URL, Astro.site).href, description: t('site.tagline'), sameAs: [config.repoUrl],
    })} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { const th = localStorage.getItem('cee-theme'); if (th) document.documentElement.setAttribute('data-theme', th); } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t('skip')}</a>
    <PreviewBanner lang={lang} />
    <Header lang={lang} hasTranslation={hasTranslation} />
    <main id="conteudo" tabindex="-1" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
