---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { href } from '../i18n/routing';
---
<Base title="Página não encontrada" noindex hasTranslation={false}>
  <div class="wrap">
    <PageHeader eyebrow="Erro 404" title="Página não encontrada"
      lede="O endereço pode ter mudado ou a página ainda não existe. Publicações nunca são removidas sem errata; se você seguiu um link de citação, avise-nos." />
    <ul class="prose">
      <li><a href={href('/')}>Início</a></li>
      <li><a href={href('/publicacoes/')}>Publicações</a></li>
      <li><a href={href('/busca/')}>Buscar no sítio</a></li>
      <li><a href={href('/contato/')}>Contato</a></li>
    </ul>
    <p class="meta" lang="en" style="margin-top:var(--s-5)">Page not found. <a href={href('/', 'en')}>English home page</a>.</p>
  </div>
</Base>
