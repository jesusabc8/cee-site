---
import { getCollection } from 'astro:content';
import PainelPage from '../../../components/obs/PainelPage.astro';

export async function getStaticPaths() {
  // Painéis previstos para o ano 2 não têm página própria.
  // O A2 (Observatório de Política Monetária) tem rotas próprias em politica-monetaria/ (ADR-022).
  const paineis = await getCollection('paineis', (p) => p.data.estado !== 'previsto' && p.id !== 'politica-monetaria');
  return paineis.map((painel) => ({ params: { painel: painel.id }, props: { painel } }));
}
const { painel } = Astro.props;
---
<PainelPage painel={painel} lang="en" />
